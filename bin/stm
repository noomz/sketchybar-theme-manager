#!/usr/bin/env bash
#
# stm — SketchyBar Theme Manager
#
# Switches SketchyBar colour themes on macOS. Reads a language-neutral TOML
# palette and writes either a Lua module (colors_generated.lua) or an in-place
# value swap into a shell colours file (colors.sh). Optional [layout] / [items]
# tables write a generated overlay; stm never rewrites the user's item files.
#
# Compatibility: written for bash 3.2 (the /bin/bash that ships with macOS).
#   - no associative arrays, no `mapfile`, no `${v^^}`, no `[[ -v ]]`
#   - no GNU-only flags: no `sed -i` without an arg, no `grep -P`,
#     no `readlink -f`, no `sort -V`, no `date -d`
#
# Security posture: palette files are untrusted input. They are parsed by awk
# only — never eval'd, never sourced. Every key and value is validated against
# a strict allowlist before any of it reaches generated code.
#
# https://github.com/noomz/sketchybar-theme-manager
# MIT License

set -euo pipefail
IFS=$' \t\n'

# Force the C locale. Without it, glob ranges like [!a-z0-9._-] use the locale's
# collation order, which in en_US.UTF-8 makes [a-z] match "A" — quietly
# defeating the slug validation. It also keeps `sort`, `tr` and `awk` byte-wise
# and deterministic, so generated files are identical on every machine.
LC_ALL=C
export LC_ALL

STM_VERSION="0.3.0"
PROGNAME="stm"

# Every palette must define these. Order here is documentation only; output is
# always sorted alphabetically.
STM_REQUIRED_KEYS="black white red green blue yellow orange magenta grey bg1 bg2 bar_bg bar_border popup_bg popup_border"

# Exit codes (documented in README).
EX_OK=0
EX_INVALID=1   # palette failed validation
EX_CONFIG=2    # config dir or format could not be resolved
EX_NOTFOUND=3  # theme not found
EX_EXISTS=4    # refusing to overwrite without --force
EX_NETWORK=5   # fetch / host / network failure
EX_USAGE=64    # bad command line

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------

OPT_QUIET=0
OPT_VERBOSE=0

err() { printf '%s: %s\n' "$PROGNAME" "$*" >&2; }
die() {
  local code="$1"
  shift
  err "$*"
  exit "$code"
}
info() { [ "$OPT_QUIET" -eq 1 ] || printf '%s\n' "$*"; }
note() { [ "$OPT_VERBOSE" -eq 1 ] && printf '%s: %s\n' "$PROGNAME" "$*" >&2; return 0; }

# ---------------------------------------------------------------------------
# Temp file handling — atomic writes, cleaned up on any exit
# ---------------------------------------------------------------------------

# Newline-separated, so a path containing a space or a glob character is still
# handled correctly.
STM_TMPFILES=""
STM_TMPDIRS=""

cleanup_tmp() {
  local f old_ifs
  old_ifs="$IFS"
  IFS=$'\n'
  for f in $STM_TMPFILES; do
    [ -n "$f" ] && rm -f "$f" 2>/dev/null
  done
  for f in $STM_TMPDIRS; do
    # Only ever remove a directory we created ourselves, by name.
    case "$f" in
      */.stm-list.?????? | */.stm-blk.??????) rm -rf "$f" 2>/dev/null ;;
    esac
  done
  IFS="$old_ifs"
  STM_TMPFILES=""
  STM_TMPDIRS=""
}
trap cleanup_tmp EXIT
trap 'cleanup_tmp; exit 130' INT
trap 'cleanup_tmp; exit 143' TERM

# mktemp_in <dir> — create a private temp file in <dir> (the same filesystem as
# the destination, so the final `mv` is atomic).
#
# The path is returned in the global STM_TMP rather than on stdout: calling this
# as `f=$(mktemp_in ...)` would run it in a subshell, and the STM_TMPFILES
# bookkeeping — and therefore the cleanup trap — would be silently lost.
STM_TMP=""
# Set by cmd_apply so the config-sh writer can name its snippet per theme.
STM_TARGET_SLUG=""
mktemp_in() {
  local dir="$1" old_umask
  [ -d "$dir" ] || die "$EX_CONFIG" "not a directory: $dir"
  old_umask=$(umask)
  umask 077
  STM_TMP=$(mktemp "$dir/.stm-tmp.XXXXXX") || {
    umask "$old_umask"
    die "$EX_CONFIG" "could not create a temporary file in $dir"
  }
  umask "$old_umask"
  STM_TMPFILES="$STM_TMPFILES
$STM_TMP"
}

# assert_writable_target <path> — refuse to write anywhere that is not either
# absent or a plain file. Without this, `mv tmp somedir` would cheerfully move
# the temp file *into* the directory and report success.
assert_writable_target() {
  local target="$1" dir
  if [ -e "$target" ] && [ ! -f "$target" ]; then
    die "$EX_CONFIG" "refusing to write $target: it exists and is not a regular file"
  fi
  dir=$(dirname "$target")
  [ -d "$dir" ] || die "$EX_CONFIG" "not a directory: $dir"
  [ -w "$dir" ] || die "$EX_CONFIG" "directory is not writable: $dir"
}

# commit_tmp <tmpfile> <target> — atomically move tmp over target, preserving a
# sensible mode (mktemp gives 0600; config files should be readable).
commit_tmp() {
  local tmp="$1" target="$2" f old_ifs kept=""
  assert_writable_target "$target"
  chmod 644 "$tmp"
  mv -f "$tmp" "$target"
  # Drop it from the cleanup list: it no longer exists under the temp name.
  old_ifs="$IFS"
  IFS=$'\n'
  for f in $STM_TMPFILES; do
    [ -n "$f" ] || continue
    [ "$f" = "$tmp" ] && continue
    kept="$kept
$f"
  done
  IFS="$old_ifs"
  STM_TMPFILES="$kept"
}

# ---------------------------------------------------------------------------
# Path helpers
# ---------------------------------------------------------------------------

# expand_tilde <path> — expand a leading ~ or ~/ to $HOME. Nothing else is
# expanded: no $VAR, no globbing, no command substitution.
expand_tilde() {
  local p="$1"
  # shellcheck disable=SC2088  # the ~ here is a literal pattern, not an expansion
  case "$p" in
    "~") printf '%s\n' "$HOME" ;;
    "~/"*) printf '%s\n' "$HOME/${p#\~/}" ;;
    *) printf '%s\n' "$p" ;;
  esac
}

# resolve_symlinks <path> — macOS has no `readlink -f`. Walk the chain by hand
# with a hop limit so a symlink loop cannot hang us.
resolve_symlinks() {
  local p="$1" hops=0 dir base target
  while [ -L "$p" ] && [ "$hops" -lt 40 ]; do
    target=$(readlink "$p") || break
    case "$target" in
      /*) p="$target" ;;
      *)
        dir=$(dirname "$p")
        p="$dir/$target"
        ;;
    esac
    hops=$((hops + 1))
  done
  # Normalise the directory part; leave the basename alone (it may not exist).
  dir=$(dirname "$p")
  base=$(basename "$p")
  if [ -d "$dir" ]; then
    dir=$(cd -- "$dir" 2>/dev/null && pwd) || dir=$(dirname "$p")
  fi
  printf '%s/%s\n' "$dir" "$base"
}

# script_dir — directory holding this script, with symlinks resolved so a
# `~/.local/bin/stm -> ../share/stm/bin/stm` install still finds its palettes.
script_dir() {
  local self
  self=$(resolve_symlinks "$0")
  dirname "$self"
}

# bundled_palette_dir — where the palettes shipped with stm live.
bundled_palette_dir() {
  local sd c
  if [ -n "${STM_ROOT:-}" ] && [ -d "$STM_ROOT/palettes" ]; then
    printf '%s\n' "$STM_ROOT/palettes"
    return 0
  fi
  sd=$(script_dir)
  for c in \
    "$sd/../palettes" \
    "$sd/../share/stm/palettes" \
    "/opt/homebrew/share/stm/palettes" \
    "/usr/local/share/stm/palettes"; do
    if [ -d "$c" ]; then
      (cd -- "$c" && pwd)
      return 0
    fi
  done
  return 1
}

# ---------------------------------------------------------------------------
# TOML parsing
#
# stm_parse_palette <file> emits a normalised, already-validated record stream:
#
#   meta<TAB>name<TAB>Tokyo Night
#   meta<TAB>slug<TAB>tokyo-night
#   color<TAB>black<TAB>0xff1a1b26
#
# Anything the strict subset does not cover is a hard error. Nothing is ever
# eval'd, sourced, or expanded.
# ---------------------------------------------------------------------------

# shellcheck disable=SC2016  # this is awk source; $ and " are awk syntax, not shell
STM_TOML_AWK='
function fail(msg) {
  printf("%s: %s: line %d: %s\n", prog, FILENAME, FNR, msg) > "/dev/stderr"
  bad = 1
  exit 1
}
BEGIN {
  section = ""
  bad = 0
  nreq = split(required, reqlist, " ")
}
{
  line = $0
  # Strip a trailing CR so CRLF files do not silently fail validation.
  sub(/\r$/, "", line)

  # Blank line
  if (line ~ /^[ \t]*$/) next
  # Whole-line comment
  if (line ~ /^[ \t]*#/) next

  # Table header
  if (line ~ /^[ \t]*\[/) {
    if (line !~ /^[ \t]*\[[ \t]*[A-Za-z0-9_-]+[ \t]*\][ \t]*(#.*)?$/)
      fail("unsupported table syntax (only plain [colors] / [extras] / [layout] / [items] headers are allowed)")
    sec = line
    sub(/^[ \t]*\[[ \t]*/, "", sec)
    sub(/[ \t]*\].*$/, "", sec)
    if (sec != "colors" && sec != "extras" && sec != "layout" && sec != "items")
      fail("unsupported table [" sec "] (only [colors], [extras], [layout] and [items] are allowed)")
    if (seen_section[sec])
      fail("duplicate [" sec "] table")
    seen_section[sec] = 1
    section = sec
    next
  }

  # key = "value"
  #
  # The value may not contain a double quote or a backslash. That single rule
  # kills escape-sequence smuggling (\", \n) before it can reach generated Lua.
  # Item names may contain a dot (cpu.percent); colour and layout keys may not.
  if (line !~ /^[ \t]*[A-Za-z_][A-Za-z0-9_.]*[ \t]*=[ \t]*"[^"\\]*"[ \t]*(#.*)?$/)
    fail("unsupported or malformed line (expected: key = \"value\")")

  key = line
  sub(/^[ \t]*/, "", key)
  sub(/[ \t]*=.*$/, "", key)

  val = line
  sub(/^[^=]*=[ \t]*"/, "", val)
  sub(/".*$/, "", val)

  if (section == "colors" || section == "extras") {
    if (key !~ /^[a-z][a-z0-9_]*$/)
      fail("invalid colour key \"" key "\" (want lower-case [a-z][a-z0-9_]*)")
    if (length(key) > 32)
      fail("colour key \"" key "\" is too long (max 32)")
    val = normalise_colour(key, val)
    if (key in colors)
      fail("duplicate colour key \"" key "\" (already defined in [" origin[key] "])")
    colors[key] = val
    origin[key] = section
    order[++ncolors] = key
    next
  }

  if (section == "layout") {
    if (key !~ /^[a-z][a-z0-9_]*$/)
      fail("invalid layout key \"" key "\" (want lower-case [a-z][a-z0-9_]*)")
    if (length(key) > 32)
      fail("layout key \"" key "\" is too long (max 32)")
    if (key in layouts)
      fail("duplicate layout key \"" key "\"")
    check_layout(key, val)
    layouts[key] = val
    layout_order[++nlayout] = key
    next
  }

  if (section == "items") {
    if (key !~ /^[a-z][a-z0-9_.]*$/)
      fail("invalid item name \"" key "\" (want lower-case [a-z][a-z0-9_.]*)")
    if (length(key) > 32)
      fail("item name \"" key "\" is too long (max 32)")
    if (key in items)
      fail("duplicate item \"" key "\"")
    if (val != "left" && val != "right" && val != "center")
      fail("invalid item slot \"" val "\" for \"" key "\" (want left, right or center)")
    items[key] = val
    item_order[++nitems] = key
    next
  }

  # Root level
  if (index(key, ".") > 0)
    fail("unsupported or malformed line (expected: key = \"value\")")
  if (key in meta)
    fail("duplicate key \"" key "\"")
  meta[key] = val
  next
}
END {
  if (bad) exit 1

  if (!("slug" in meta)) fail_end("missing required key: slug")
  if (!("name" in meta)) fail_end("missing required key: name")

  slug = meta["slug"]
  if (slug !~ /^[a-z0-9][a-z0-9._-]*$/)
    fail_end("invalid slug \"" slug "\" (want [a-z0-9][a-z0-9._-]*)")
  if (length(slug) > 64)
    fail_end("slug is too long (max 64)")
  if (slug == "." || slug == "..")
    fail_end("invalid slug \"" slug "\"")
  if (index(slug, "/") > 0)
    fail_end("slug may not contain \"/\"")

  # name and variant_label are embedded in generated comments, so their charset
  # is restricted to something that cannot break out of a comment.
  check_label("name", meta["name"])
  if ("variant_label" in meta) check_label("variant_label", meta["variant_label"])

  if (ncolors == 0) fail_end("no [colors] table found")


  # nreq is 0 when the caller is collecting one link of a `base` chain: the
  # required keys only have to be present once the whole chain is merged.
  missing = ""
  for (i = 1; i <= nreq; i++) {
    if (!(reqlist[i] in colors)) missing = missing " " reqlist[i]
  }
  if (missing != "") fail_end("missing required colour key(s):" missing)

  printf("meta\tname\t%s\n", meta["name"])
  printf("meta\tslug\t%s\n", slug)
  if ("variant_label" in meta)
    printf("meta\tvariant_label\t%s\n", meta["variant_label"])
  else
    printf("meta\tvariant_label\t%s\n", meta["name"])
  if ("base" in meta) {
    if (meta["base"] !~ /^[a-z0-9][a-z0-9._-]*$/)
      fail_end("invalid base \"" meta["base"] "\" (want a palette slug)")
    if (meta["base"] == slug)
      fail_end("palette \"" slug "\" cannot inherit from itself")
    printf("meta\tbase\t%s\n", meta["base"])
  }

  for (i = 1; i <= ncolors; i++) {
    if (origin[order[i]] == "extras")
      printf("extra\t%s\t%s\n", order[i], colors[order[i]])
    else
      printf("color\t%s\t%s\n", order[i], colors[order[i]])
  }

  if (seen_section["items"])
    printf("meta\thas_items\t1\n")
  for (i = 1; i <= nlayout; i++)
    printf("layout\t%s\t%s\n", layout_order[i], layouts[layout_order[i]])
  for (i = 1; i <= nitems; i++)
    printf("item\t%s\t%s\n", item_order[i], items[item_order[i]])
}

# normalise_colour — accept 0xAARRGGBB or #RRGGBB, always return lower-case
# 0xAARRGGBB. Everything downstream therefore still only ever sees a validated
# 8-hex-digit literal, which is what keeps generated code inert.
function normalise_colour(k, v) {
  if (v ~ /^0[xX][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/) {
    v = tolower(v)
    sub(/^0x/, "0x", v)
    return v
  }
  if (v ~ /^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/) {
    v = tolower(v)
    sub(/^#/, "", v)
    return "0xff" v
  }
  if (v ~ /^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/)
    fail("invalid colour value for \"" k "\": \"" v "\" (3-digit #rgb is not supported; write #rrggbb)")
  if (v ~ /^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/)
    fail("invalid colour value for \"" k "\": \"" v "\" (# means RGB; use 0xAARRGGBB for alpha)")
  fail("invalid colour value for \"" k "\": \"" v "\" (want 0xAARRGGBB or #RRGGBB)")
}
function int_in(v, lo, hi,   n) {
  if (v !~ /^-?[0-9]+$/) return 0
  n = v + 0
  if (n < lo || n > hi) return 0
  return 1
}
function uint_in(v, lo, hi,   n) {
  if (v !~ /^[0-9]+$/) return 0
  n = v + 0
  if (n < lo || n > hi) return 0
  return 1
}
# Layout values are data only: enums and small integers. A value that is not
# on this list is refused rather than passed through to generated Lua.
function check_layout(k, v) {
  if (k == "position") {
    if (v == "top" || v == "bottom") return
    fail("invalid layout value for \"" k "\": \"" v "\" (want top or bottom)")
  }
  if (k == "sticky" || k == "topmost" || k == "shadow" || k == "hidden" || k == "font_smoothing") {
    if (v == "on" || v == "off") return
    fail("invalid layout value for \"" k "\": \"" v "\" (want on or off)")
  }
  if (k == "display") {
    if (v == "main" || v == "all") return
    if (uint_in(v, 1, 99)) return
    fail("invalid layout value for \"" k "\": \"" v "\" (want main, all or 1-99)")
  }
  if (k == "height") {
    if (uint_in(v, 1, 256)) return
    fail("invalid layout value for \"" k "\": \"" v "\" (want 1-256)")
  }
  if (k == "y_offset") {
    if (int_in(v, -256, 256)) return
    fail("invalid layout value for \"" k "\": \"" v "\" (want -256-256)")
  }
  if (k == "notch_display_height" || k == "margin" || k == "corner_radius" ||
      k == "border_width" || k == "blur_radius" || k == "padding_left" ||
      k == "padding_right" || k == "notch_width" || k == "notch_offset") {
    if (uint_in(v, 0, 256)) return
    fail("invalid layout value for \"" k "\": \"" v "\" (want 0-256)")
  }
  fail("unsupported layout key \"" k "\"")
}
function fail_end(msg) {
  printf("%s: %s: %s\n", prog, FILENAME, msg) > "/dev/stderr"
  exit 1
}
function check_label(what, s) {
  if (s !~ /^[A-Za-z0-9 ._()+-]+$/)
    fail_end("invalid " what " \"" s "\" (allowed: letters, digits, space . _ ( ) + -)")
  if (length(s) > 64)
    fail_end(what " is too long (max 64)")
}
'

# stm_parse_one <file> — parse a single palette file with no required-key check.
# Used for each link of a `base` chain; the required keys only have to be
# satisfied once the whole chain has been merged.
stm_parse_one() {
  local file="$1"
  [ -f "$file" ] || die "$EX_NOTFOUND" "palette file not found: $file"
  [ -r "$file" ] || die "$EX_INVALID" "palette file is not readable: $file"

  if ! awk -v prog="$PROGNAME" -v required="" "$STM_TOML_AWK" "$file"; then
    die "$EX_INVALID" "invalid palette: $file"
  fi
}

# Maximum length of a `base =` inheritance chain.
STM_MAX_BASE_DEPTH=8

# stm_parse_palette <file> — the real entry point. Resolves any `base =` chain,
# merges it child-last, defaults `transparent`, then enforces the required keys
# on the merged result.
stm_parse_palette() {
  local file="$1"
  local chain="" seen="" depth=0 base slug merged tmpdir out missing k
  local cur="$file"

  tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/.stm-list.XXXXXX") ||
    die "$EX_CONFIG" "could not create a temporary directory"
  STM_TMPDIRS="$STM_TMPDIRS
$tmpdir"
  merged="$tmpdir/merged"
  : >"$merged"

  # Walk the chain child -> base, collecting file paths.
  while :; do
    out=$(stm_parse_one "$cur")
    printf '%s\n' "$out" >"$tmpdir/link.$depth"

    slug=$(printf '%s\n' "$out" | awk -F'\t' '$1=="meta" && $2=="slug" { print $3; exit }')
    case "$seen" in
      *"|$slug|"*)
        die "$EX_INVALID" "circular base chain in $file: $chain$slug"
        ;;
    esac
    seen="$seen|$slug|"
    chain="$chain$slug -> "

    base=$(printf '%s\n' "$out" | awk -F'\t' '$1=="meta" && $2=="base" { print $3; exit }')
    [ -n "$base" ] || break

    depth=$((depth + 1))
    if [ "$depth" -ge "$STM_MAX_BASE_DEPTH" ]; then
      die "$EX_INVALID" "base chain deeper than $STM_MAX_BASE_DEPTH in $file: $chain"
    fi

    validate_slug "$base"
    cur=$(find_palette_file "$base") ||
      die "$EX_NOTFOUND" "palette \"$slug\" inherits from \"$base\", which was not found"
  done

  # Merge base-first so the child overrides. link.$depth is the deepest base.
  local i
  i="$depth"
  while [ "$i" -ge 0 ]; do
    awk -F'\t' '$1=="color" || $1=="extra" || $1=="layout"' "$tmpdir/link.$i" >>"$merged"
    i=$((i - 1))
  done

  # Last value wins per key; a key may be promoted from extra to color (or the
  # reverse) by a child, so the kind travels with the winning definition.
  # Layout keys merge the same way. Items are not in $merged: a child [items]
  # table replaces the parent's list entirely.
  local colours layouts items
  colours=$(awk -F'\t' '
    $1 == "color" || $1 == "extra" {
      kind[$2] = $1; val[$2] = $3
      if (!($2 in seen)) { seen[$2] = 1; order[++n] = $2 }
    }
    END { for (i = 1; i <= n; i++) printf("%s\t%s\t%s\n", kind[order[i]], order[i], val[order[i]]) }
  ' "$merged")
  layouts=$(awk -F'\t' '
    $1 == "layout" {
      val[$2] = $3
      if (!($2 in seen)) { seen[$2] = 1; order[++n] = $2 }
    }
    END { for (i = 1; i <= n; i++) printf("layout\t%s\t%s\n", order[i], val[order[i]]) }
  ' "$merged")
  items=""
  i=0
  while [ "$i" -le "$depth" ]; do
    if awk -F'\t' '$1=="meta" && $2=="has_items" { found=1 } END { exit !found }' \
      "$tmpdir/link.$i"; then
      items=$(awk -F'\t' '$1=="item"' "$tmpdir/link.$i")
      break
    fi
    i=$((i + 1))
  done

  # `transparent` is universally 0x00000000 and several real configs reference
  # colors.transparent unguarded, so default it once, after merging.
  if ! printf '%s\n' "$colours" | awk -F'\t' '$2=="transparent"' | grep -q .; then
    colours="$colours
color	transparent	0x00000000"
  fi

  missing=""
  for k in $STM_REQUIRED_KEYS; do
    if ! printf '%s\n' "$colours" | awk -F'\t' -v k="$k" '$2==k' | grep -q .; then
      missing="$missing $k"
    fi
  done
  if [ -n "$missing" ]; then
    die "$EX_INVALID" "$file: missing required colour key(s):$missing"
  fi

  # Metadata comes from the child (link.0) alone, except has_items which
  # follows the winning item list.
  awk -F'\t' '$1=="meta" && $2!="has_items"' "$tmpdir/link.0"
  printf '%s\n' "$colours"
  [ -n "$layouts" ] && printf '%s\n' "$layouts"
  if [ -n "$items" ]; then
    printf 'meta\thas_items\t1\n'
    printf '%s\n' "$items"
  fi

  rm -rf "$tmpdir"
}

# stm_records_meta <records> <key> — pull one meta value out of a record stream.
stm_records_meta() {
  printf '%s\n' "$1" | awk -F'\t' -v k="$2" '$1=="meta" && $2==k { print $3; exit }'
}

# stm_records_colors <records> — emit "key<TAB>value" colour lines, sorted.
# All colour keys the writers should emit: [colors] and [extras] alike. Extras
# are ordinary colours with a different provenance, not a different kind of
# value, so a config that names one gets it swapped like any other.
stm_records_colors() {
  printf '%s\n' "$1" | awk -F'\t' '$1=="color" || $1=="extra" { printf("%s\t%s\n", $2, $3) }' | sort
}

# Only the [extras] keys, for `{{extras_*}}` template blocks and doctor.
stm_records_extras() {
  printf '%s\n' "$1" | awk -F'\t' '$1=="extra" { printf("%s\t%s\n", $2, $3) }' | sort
}

# Layout keys in declaration (merge) order. Not sorted: preview and export
# should follow the palette.
stm_records_layout() {
  printf '%s\n' "$1" | awk -F'\t' '$1=="layout" { printf("%s\t%s\n", $2, $3) }'
}

# Item name<TAB>slot rows, declaration order.
stm_records_items() {
  printf '%s\n' "$1" | awk -F'\t' '$1=="item" { printf("%s\t%s\n", $2, $3) }'
}

# True if the resolved records carry any layout or item data.
stm_records_has_layout() {
  printf '%s\n' "$1" | awk -F'\t' '$1=="layout" || $1=="item" { found=1; exit } END { exit !found }'
}

# layout_is_int <key> — bar properties that must be emitted as Lua numbers.
layout_is_int() {
  case "$1" in
    height | notch_display_height | margin | y_offset | corner_radius | \
    border_width | blur_radius | padding_left | padding_right | \
    notch_width | notch_offset) return 0 ;;
    *) return 1 ;;
  esac
}

# apply_alpha <records> — apply [alpha] overrides from stm.config.toml.
#
#   [alpha]
#   bar_bg = "60"        # keep my bar 38% opaque whatever the theme says
#   popup_bg = "e0"
#
# Transparency is a property of how *you* like your bar to look, not of the
# theme's colour scheme. Without this, every palette dictates both, and a theme
# built around a fully transparent bar makes an opaque one invisible when
# applied to a config that wanted otherwise. The theme supplies the hue; this
# supplies the alpha byte.
apply_alpha() {
  local records="$1" key val out
  [ -n "$RESOLVED_CONFIG" ] || { printf '%s\n' "$records"; return 0; }
  stm_config_pairs "$RESOLVED_CONFIG" alpha | grep -q . || {
    printf '%s\n' "$records"
    return 0
  }

  out="$records"
  while IFS=$'\t' read -r key val; do
    [ -n "$key" ] || continue
    case "$key" in
      *[!a-z0-9_]* | [!a-z]*)
        die "$EX_CONFIG" "[alpha] invalid key \"$key\" (want lower-case [a-z][a-z0-9_]*)"
        ;;
    esac
    case "$val" in
      [0-9a-fA-F][0-9a-fA-F]) : ;;
      *) die "$EX_CONFIG" "[alpha] $key = \"$val\" must be exactly two hex digits (00-ff)" ;;
    esac
    out=$(printf '%s\n' "$out" | awk -F'\t' -v k="$key" -v a="$val" '
      BEGIN { a = tolower(a) }
      ($1 == "color" || $1 == "extra") && $2 == k {
        printf("%s\t%s\t0x%s%s\n", $1, $2, a, substr($3, 5))
        next
      }
      { print }
    ')
  done <<EOF
$(stm_config_pairs "$RESOLVED_CONFIG" alpha)
EOF

  printf '%s\n' "$out"
}

# theme_note <slug> — the free-text note for a theme from [notes], if any.
theme_note() {
  [ -n "$RESOLVED_CONFIG" ] || return 1
  stm_config_section_get "$RESOLVED_CONFIG" notes "$1" 2>/dev/null
}

# apply_mapping <records> — fold [mapping] from stm.config.toml into the record
# stream, so everything downstream sees one flat set of key -> hex pairs.
#
#   [mapping]
#   grey = "gray"            # my config says grey; the canonical key is gray
#   custom = "#ff0000"       # my config says custom; pin it to a literal
#
# The left side is the name as it appears in the *user's* config and templates.
# It can only ever produce another `key -> validated hex` pair: mapping cannot
# name a path, a command, or anything else.
# STM_MAPPING_STRICT=0 makes an unresolvable entry a skipped warning instead of
# a fatal error. `doctor` sets it, because its job is to report problems rather
# than to stop at the first one.
STM_MAPPING_STRICT=1

apply_mapping() {
  local records="$1" key val resolved out
  [ -n "$RESOLVED_CONFIG" ] || { printf '%s\n' "$records"; return 0; }

  out="$records"
  while IFS=$'\t' read -r key val; do
    [ -n "$key" ] || continue
    case "$key" in
      *[!a-z0-9_]* | [!a-z]*)
        if [ "$STM_MAPPING_STRICT" -eq 0 ]; then continue; fi
        die "$EX_CONFIG" "[mapping] invalid key \"$key\" (want lower-case [a-z][a-z0-9_]*)"
        ;;
    esac

    case "$val" in
      "0x"* | "#"*)
        # A literal. Validate it exactly like a palette value.
        resolved=$(printf 'x\t%s\n' "$val" | awk -F'\t' '
          $2 ~ /^0[xX][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/ { print tolower($2); ok = 1 }
          $2 ~ /^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/ { v = tolower($2); sub(/^#/, "", v); print "0xff" v; ok = 1 }
          END { if (!ok) exit 1 }')
        if [ -z "$resolved" ]; then
          if [ "$STM_MAPPING_STRICT" -eq 0 ]; then continue; fi
          die "$EX_CONFIG" "[mapping] $key = \"$val\" is not a valid colour (want 0xAARRGGBB or #RRGGBB)"
        fi
        ;;
      *)
        # A canonical key. It must already exist in the palette, or the user has
        # a typo that would otherwise silently produce nothing.
        resolved=$(printf '%s\n' "$records" |
          awk -F'\t' -v k="$val" '($1=="color" || $1=="extra") && $2==k { print $3; exit }')
        if [ -z "$resolved" ]; then
          if [ "$STM_MAPPING_STRICT" -eq 0 ]; then continue; fi
          die "$EX_CONFIG" "[mapping] $key = \"$val\": no colour named \"$val\" in this palette"
        fi
        ;;
    esac

    out="$out
color	$key	$resolved"
  done <<EOF
$(stm_config_pairs "$RESOLVED_CONFIG" mapping)
EOF

  # A mapped key overrides a palette key of the same name: last definition wins.
  printf '%s\n' "$out" | awk -F'\t' '
    $1=="meta" { print; next }
    { kind[$2] = $1; val[$2] = $3
      if (!($2 in seen)) { seen[$2] = 1; order[++n] = $2 } }
    END { for (i = 1; i <= n; i++) printf("%s\t%s\t%s\n", kind[order[i]], order[i], val[order[i]]) }
  '
}

# ---------------------------------------------------------------------------
# Minimal reader for stm.config.toml (root-level strings only)
# ---------------------------------------------------------------------------

# The config grammar is the same restricted subset as a palette: `key = "value"`
# strings, `#` comments, and plain `[section]` headers. It is never sourced and
# no `$` expansion happens, so a config file cannot execute anything.
#
# stm_config_pairs <file> <section> — emit `key<TAB>value` for one section.
# Pass "" as <section> for the root (pre-header) keys.
#
# shellcheck disable=SC2016  # awk source
STM_CONFIG_AWK='
{ line = $0; sub(/\r$/, "", line) }
line ~ /^[ \t]*$/ { next }
line ~ /^[ \t]*#/ { next }
line ~ /^[ \t]*\[/ {
  sec = line
  sub(/^[ \t]*\[[ \t]*/, "", sec)
  sub(/[ \t]*\].*$/, "", sec)
  cur = sec
  next
}
{
  if (cur != want) next
  if (line !~ /^[ \t]*[A-Za-z_][A-Za-z0-9_.-]*[ \t]*=[ \t]*"[^"\\]*"[ \t]*(#.*)?$/) next
  k = line; sub(/^[ \t]*/, "", k); sub(/[ \t]*=.*$/, "", k)
  v = line; sub(/^[^=]*=[ \t]*"/, "", v); sub(/".*$/, "", v)
  printf("%s\t%s\n", k, v)
}
'

stm_config_pairs() {
  local file="$1" section="$2"
  [ -f "$file" ] || return 0
  awk -v want="$section" "$STM_CONFIG_AWK" "$file"
}

# stm_config_get <file> <key> — a root-level scalar.
stm_config_get() {
  local file="$1" key="$2" v
  [ -f "$file" ] || return 1
  v=$(stm_config_pairs "$file" "" | awk -F'\t' -v k="$key" '$1==k { print $2; exit }')
  [ -n "$v" ] || return 1
  printf '%s\n' "$v"
}

# stm_config_section_get <file> <section> <key>
stm_config_section_get() {
  local file="$1" section="$2" key="$3" v
  [ -f "$file" ] || return 1
  v=$(stm_config_pairs "$file" "$section" | awk -F'\t' -v k="$key" '$1==k { print $2; exit }')
  [ -n "$v" ] || return 1
  printf '%s\n' "$v"
}

# ---------------------------------------------------------------------------
# Resolution: config file, sketchybar dir, palette dirs, format
# ---------------------------------------------------------------------------

OPT_CONFIG=""
OPT_DIR=""
OPT_PALETTE_DIR=""
OPT_FORMAT=""
OPT_NO_RELOAD=0
OPT_DRY_RUN=0
OPT_FORCE=0
OPT_PORCELAIN=0
OPT_APPEND_MISSING=0
OPT_LUA_DIALECT=""
OPT_OUT=""
OPT_SLUG=""
OPT_BASE=""
OPT_NO_MANIFEST=0
OPT_BACKUP_EACH=0
OPT_NO_BACKUP=0
OPT_RESET_LAYOUT=0
OPT_ALL=0
OPT_NO_WIRE=0
OPT_NO_LAYOUT=0
OPT_ALLOW_HOST=""

RESOLVED_CONFIG=""
RESOLVED_DIR=""
RESOLVED_FORMAT=""
RESOLVED_LUA_DIALECT="flat"

resolve_config_file() {
  local c
  if [ -n "$OPT_CONFIG" ]; then
    c=$(expand_tilde "$OPT_CONFIG")
    [ -f "$c" ] || die "$EX_CONFIG" "config file not found: $c"
    RESOLVED_CONFIG="$c"
    return 0
  fi
  if [ -n "${STM_CONFIG:-}" ]; then
    c=$(expand_tilde "$STM_CONFIG")
    [ -f "$c" ] || die "$EX_CONFIG" "STM_CONFIG points at a missing file: $c"
    RESOLVED_CONFIG="$c"
    return 0
  fi
  # The SketchyBar config dir is the most natural home for stm.config.toml —
  # it sits next to the config it describes and travels with the dotfiles repo.
  # It is resolved here from the flag, the environment, or the default only:
  # reading `sketchybar_dir` out of the config would need the config we are
  # still looking for.
  local sbdir
  if [ -n "$OPT_DIR" ]; then
    sbdir=$(expand_tilde "$OPT_DIR")
  elif [ -n "${SKETCHYBAR_CONFIG_DIR:-}" ]; then
    sbdir=$(expand_tilde "$SKETCHYBAR_CONFIG_DIR")
  else
    sbdir="${XDG_CONFIG_HOME:-$HOME/.config}/sketchybar"
  fi

  for c in \
    "./stm.config.toml" \
    "$sbdir/stm.config.toml" \
    "${XDG_CONFIG_HOME:-$HOME/.config}/stm/stm.config.toml"; do
    if [ -f "$c" ]; then
      RESOLVED_CONFIG="$c"
      return 0
    fi
  done
  RESOLVED_CONFIG=""
  return 0
}

resolve_sketchybar_dir() {
  local d=""
  if [ -n "$OPT_DIR" ]; then
    d="$OPT_DIR"
  elif [ -n "${SKETCHYBAR_CONFIG_DIR:-}" ]; then
    d="$SKETCHYBAR_CONFIG_DIR"
  elif [ -n "$RESOLVED_CONFIG" ] && d=$(stm_config_get "$RESOLVED_CONFIG" sketchybar_dir); then
    :
  else
    d="${XDG_CONFIG_HOME:-$HOME/.config}/sketchybar"
  fi
  RESOLVED_DIR=$(expand_tilde "$d")
  note "sketchybar dir: $RESOLVED_DIR"
}

# palette_dirs — echo the search path, one directory per line, highest
# precedence first. User directories shadow bundled palettes of the same slug.
palette_dirs() {
  local d bundled
  if [ -n "$OPT_PALETTE_DIR" ]; then
    # --palette-dir replaces the *user* search path, but the bundled palettes
    # stay available: a palette that inherits via `base =` from a shipped theme
    # must still resolve, and `stm list` should not appear to lose them.
    printf '%s\n' "$(expand_tilde "$OPT_PALETTE_DIR")"
    if bundled=$(bundled_palette_dir); then
      printf '%s\n' "$bundled"
    fi
    return 0
  fi
  [ -n "${STM_PALETTE_DIR:-}" ] && printf '%s\n' "$(expand_tilde "$STM_PALETTE_DIR")"
  if [ -n "$RESOLVED_CONFIG" ] && d=$(stm_config_get "$RESOLVED_CONFIG" palette_dir); then
    printf '%s\n' "$(expand_tilde "$d")"
  fi
  [ -n "$RESOLVED_DIR" ] && printf '%s\n' "$RESOLVED_DIR/palettes"
  if bundled=$(bundled_palette_dir); then
    printf '%s\n' "$bundled"
  fi
}

# user_palette_dir — the first writable non-bundled directory, for `stm add`.
# Fed by a heredoc rather than a pipe: breaking out of a `cmd | while` loop
# closes the pipe under the still-writing producer, and with `set -o pipefail`
# that SIGPIPE becomes a spurious exit 141.
user_palette_dir() {
  local bundled d
  bundled=$(bundled_palette_dir 2>/dev/null || true)
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    [ "$d" = "$bundled" ] && continue
    printf '%s\n' "$d"
    return 0
  done <<EOF
$(palette_dirs)
EOF
  return 1
}

# find_palette <slug> — echo the path of the highest-precedence palette file.
# find_palette_file <slug> — raw lookup with no validation. Callers must have
# validated the slug already; use find_palette unless you have.
find_palette_file() {
  local slug="$1" d
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    if [ -f "$d/$slug.toml" ]; then
      printf '%s\n' "$d/$slug.toml"
      return 0
    fi
  done <<EOF
$(palette_dirs)
EOF
  return 1
}

find_palette() {
  local slug="$1" d
  validate_slug "$slug"
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    if [ -f "$d/$slug.toml" ]; then
      printf '%s\n' "$d/$slug.toml"
      return 0
    fi
  done <<EOF
$(palette_dirs)
EOF
  return 1
}

# validate_slug <slug> — the same rule the parser enforces, applied to CLI input
# before it is ever concatenated into a path.
validate_slug() {
  local s="$1"
  case "$s" in
    "" | "." | "..") die "$EX_NOTFOUND" "invalid theme name: \"$s\"" ;;
    */*) die "$EX_NOTFOUND" "invalid theme name (may not contain \"/\"): \"$s\"" ;;
  esac
  if [ "${#s}" -gt 64 ]; then
    die "$EX_NOTFOUND" "theme name is too long (max 64): \"$s\""
  fi
  # Portable charset check without bash 4 features.
  case "$s" in
    *[!a-z0-9._-]*) die "$EX_NOTFOUND" "invalid theme name \"$s\" (allowed: a-z 0-9 . _ -)" ;;
  esac
  case "$s" in
    [a-z0-9]*) : ;;
    *) die "$EX_NOTFOUND" "theme name must start with a letter or digit: \"$s\"" ;;
  esac
}

# ---------------------------------------------------------------------------
# lint — bytes + allowlist + slug + capability + generate-and-grep
#
# Palettes are untrusted. lint is the only writer of the "is this a palette,
# and can it reach a shell?" verdict. It writes nothing to the user's bar.
# ---------------------------------------------------------------------------

STM_LINT_MAX_BYTES=65536

# lint_bytes_gate <file> — size, NUL, shebang, printable text. Fail-closed.
lint_bytes_gate() {
  local file="$1" sz stripped
  sz=$(wc -c <"$file" | tr -d ' ')
  if [ "$sz" -gt "$STM_LINT_MAX_BYTES" ]; then
    die "$EX_INVALID" "$file: too large ($sz bytes; max $STM_LINT_MAX_BYTES)"
  fi
  stripped=$(tr -d '\000' <"$file" | wc -c | tr -d ' ')
  if [ "$stripped" -ne "$sz" ]; then
    die "$EX_INVALID" "$file: contains a NUL byte"
  fi
  if grep -qF '#!' "$file"; then
    die "$EX_INVALID" "$file: shebang is not allowed"
  fi
  # Printable ASCII + tab/LF/CR + high bytes (UTF-8 comments). Reject other
  # C0 controls and DEL. Palettes cite upstream with an em-dash.
  stripped=$(tr -d '\11\12\15\40-\176\200-\377' <"$file" | wc -c | tr -d ' ')
  if [ "$stripped" -ne 0 ]; then
    die "$EX_INVALID" "$file: does not look like text"
  fi
}

# lint_slug_rules <file> <declared> — validate the declared slug; a *.toml
# basename must match it (the name install would give the file).
lint_slug_rules() {
  local file="$1" declared="$2" base want
  validate_slug "$declared"
  base=$(basename "$file")
  case "$base" in
    *.toml)
      want="${base%.toml}"
      if [ "$declared" != "$want" ]; then
        die "$EX_INVALID" "palette $file declares slug \"$declared\" but is filed as \"$want\""
      fi
      ;;
  esac
}

# lint_capability_scan <file> — raw-byte "no shell access" check. Comments
# count: the parser strips them, which is why this scan exists.
# shellcheck disable=SC2016  # awk source; $ and ` are the tokens we search for
lint_capability_scan() {
  local file="$1"
  if ! awk -v prog="$PROGNAME" '
    function hit(tok) {
      printf("%s: %s: line %d: capability refused (%s)\n", prog, FILENAME, FNR, tok) > "/dev/stderr"
      exit 1
    }
    {
      if (index($0, "`") > 0) hit("`")
      if (index($0, "$(") > 0) hit("$(")
      if (index($0, "os.execute") > 0) hit("os.execute")
      if (index($0, "io.popen") > 0) hit("io.popen")
      if (index($0, "loadstring") > 0) hit("loadstring")
      if (index($0, "dofile") > 0) hit("dofile")
      if (index($0, "require(") > 0) hit("require(")
      if (index($0, "\\x") > 0) hit("\\x")
      if (index($0, "function") > 0) hit("function")
      if (index($0, "source ") > 0) hit("source ")
      if (index($0, "eval") > 0) hit("eval")
    }
  ' "$file"; then
    die "$EX_INVALID" "palette failed the capability scan: $file"
  fi
}

# lint_check_lua_hex <file> — assignment lines must be `  key = 0xAARRGGBB,`.
# Comments, table wrappers, and stm's own with_alpha helper are allowed.
# shellcheck disable=SC2016  # awk source
lint_check_lua_hex() {
  local file="$1"
  awk '
    /^--/ { next }
    /^[ \t]*$/ { next }
    /^local with_alpha/ { in_fn = 1; next }
    in_fn {
      if ($0 == "end") in_fn = 0
      next
    }
    /^return \{$/ { next }
    /^\}$/ { next }
    /^  [a-z]+ = \{$/ { next }
    /^  \},$/ { next }
    /^  with_alpha = with_alpha,$/ { next }
    /^  [a-z][a-z0-9_]* = 0x[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f],$/ { next }
    /^    [a-z][a-z0-9_]* = 0x[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f],$/ { next }
    {
      printf("generated Lua is not hex-only: %s\n", $0) > "/dev/stderr"
      bad = 1
      exit 1
    }
    END { if (bad) exit 1 }
  ' "$file"
}

# lint_check_shell_assigns <file> — assignment lines introduce no [;&|`] or $().
lint_check_shell_assigns() {
  local file="$1"
  if grep -E '^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=' "$file" |
    grep -qE '[;&|`]|\$\('; then
    return 1
  fi
  return 0
}

# lint_check_layout_lua <file> — overlay assignments must stay data-only.
# shellcheck disable=SC2016  # awk source
lint_check_layout_lua() {
  local file="$1"
  awk '
    /^--/ { next }
    /=/ {
      if ($0 ~ /[;&|`]/ || index($0, "$(") > 0) {
        printf("generated layout Lua has a metacharacter: %s\n", $0) > "/dev/stderr"
        exit 1
      }
    }
  ' "$file"
}

# lint_generate_and_grep <records> — run writers into a private temp dir
# (never the user's bar) and refuse anything that is not hex / data-only.
lint_generate_and_grep() {
  local records="$1" dir saved_dialect saved_append

  dir=$(mktemp -d "${TMPDIR:-/tmp}/.stm-list.XXXXXX") ||
    die "$EX_CONFIG" "could not create a temporary directory"
  STM_TMPDIRS="$STM_TMPDIRS
$dir"

  saved_dialect="$RESOLVED_LUA_DIALECT"
  saved_append="$OPT_APPEND_MISSING"

  RESOLVED_LUA_DIALECT="flat"
  write_lua "$records" "$dir/colors_generated.lua"
  if ! lint_check_lua_hex "$dir/colors_generated.lua"; then
    rm -rf "$dir"
    die "$EX_INVALID" "generated Lua is not hex-only"
  fi

  RESOLVED_LUA_DIALECT="nested"
  write_lua "$records" "$dir/colors_generated_nested.lua"
  if ! lint_check_lua_hex "$dir/colors_generated_nested.lua"; then
    rm -rf "$dir"
    die "$EX_INVALID" "generated nested Lua is not hex-only"
  fi

  {
    printf '#!/usr/bin/env bash\n'
    printf 'export BLACK=0xff000000\n'
    printf 'export WHITE=0xffffffff\n'
    printf 'export RED=0xffff0000\n'
    printf 'export GREEN=0xff00ff00\n'
    printf 'export BLUE=0xff0000ff\n'
    printf 'export YELLOW=0xffffff00\n'
    printf 'export ORANGE=0xffff8800\n'
    printf 'export MAGENTA=0xffff00ff\n'
    printf 'export GREY=0xff888888\n'
    printf 'export BG1=0xff111111\n'
    printf 'export BG2=0xff222222\n'
    printf 'export BAR_BG=0x00000000\n'
    printf 'export BAR_BORDER=0xff333333\n'
    printf 'export POPUP_BG=0xc0111111\n'
    printf 'export POPUP_BORDER=0xff888888\n'
    printf 'export TRANSPARENT=0x00000000\n'
  } >"$dir/colors.sh"

  OPT_APPEND_MISSING=1
  write_bash "$records" "$dir/colors.sh"
  if ! lint_check_shell_assigns "$dir/colors.sh"; then
    rm -rf "$dir"
    die "$EX_INVALID" "generated shell assignment contains a metacharacter"
  fi

  write_config_sh "$records" "$dir/theme.sh"
  if ! lint_check_shell_assigns "$dir/theme.sh"; then
    rm -rf "$dir"
    die "$EX_INVALID" "generated config-sh assignment contains a metacharacter"
  fi

  if stm_records_has_layout "$records"; then
    write_layout_lua "$records" "$dir/layout_generated.lua"
    write_layout_sh "$records" "$dir/layout.sh"
    if ! lint_check_layout_lua "$dir/layout_generated.lua"; then
      rm -rf "$dir"
      die "$EX_INVALID" "generated layout Lua contains a metacharacter"
    fi
    if ! lint_check_shell_assigns "$dir/layout.sh"; then
      rm -rf "$dir"
      die "$EX_INVALID" "generated layout shell assignment contains a metacharacter"
    fi
  fi

  RESOLVED_LUA_DIALECT="$saved_dialect"
  OPT_APPEND_MISSING="$saved_append"
  rm -rf "$dir"
}

# stm_lint_file <file> — the public lint pipeline on an already-resolved path.
# Writes nothing. Dies EX_INVALID on refuse. Sets STM_LINT_SLUG to the declared slug.
STM_LINT_SLUG=""
stm_lint_file() {
  local file="$1" records declared
  [ -r "$file" ] || die "$EX_INVALID" "palette file is not readable: $file"
  lint_bytes_gate "$file"
  records=$(stm_parse_palette "$file")
  declared=$(stm_records_meta "$records" slug)
  lint_slug_rules "$file" "$declared"
  lint_capability_scan "$file"
  lint_generate_and_grep "$records"
  STM_LINT_SLUG="$declared"
}

# ---------------------------------------------------------------------------
# install spec + HTTPS fetch
#
# A spec locates one .toml. Never git clone. STM_FETCH, when set, is a stub
# invoked as `STM_FETCH <url> <dest>` so tests never open the network.
# ---------------------------------------------------------------------------

STM_SPEC_MAX=1024
STM_SPEC_URL=""
STM_SPEC_URL_FALLBACK=""
STM_SPEC_REF=""
STM_SPEC_HOST=""
STM_SPEC_PATH=""

stm_lc() {
  # ASCII only. LC_ALL=C is forced at the top of this file.
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

stm_validate_fetch_host() {
  local h
  h=$(stm_lc "$1")
  case "$h" in
    "" | localhost | *.localhost)
      die "$EX_USAGE" "install host is not allowed: $1"
      ;;
  esac
  case "$h" in
    *:*)
      die "$EX_USAGE" "install host must not be an IP or contain a port: $1"
      ;;
  esac
  case "$h" in
    *[!a-z0-9.-]* | -* | *- | .* | *. | *..*)
      die "$EX_USAGE" "invalid install host: $1"
      ;;
  esac
  case "$h" in
    *[!0-9.]*) : ;;
    *) die "$EX_USAGE" "install host must not be a numeric IP: $1" ;;
  esac
  case "$h" in
    github.com | raw.githubusercontent.com | gitlab.com | codeberg.org) return 0 ;;
  esac
  if [ -n "$OPT_ALLOW_HOST" ] && [ "$h" = "$(stm_lc "$OPT_ALLOW_HOST")" ]; then
    return 0
  fi
  die "$EX_USAGE" "host not allowed: $1 (pass --allow-host)"
}

stm_validate_git_name() {
  local n="$1" what="$2"
  [ -n "$n" ] || die "$EX_USAGE" "install spec is missing $what"
  [ "${#n}" -le 100 ] || die "$EX_USAGE" "install spec $what is too long"
  case "$n" in
    *[!A-Za-z0-9._-]*) die "$EX_USAGE" "invalid $what in install spec: $n" ;;
    -*|.*) die "$EX_USAGE" "invalid $what in install spec: $n" ;;
  esac
}

stm_validate_ref() {
  local r="$1"
  [ -n "$r" ] || die "$EX_USAGE" "install spec is missing a ref"
  [ "${#r}" -le 128 ] || die "$EX_USAGE" "install spec ref is too long"
  case "$r" in
    *[!A-Za-z0-9._-]*) die "$EX_USAGE" "invalid ref in install spec: $r" ;;
  esac
}

# Sets STM_SPEC_PATH and STM_SPEC_URL_FALLBACK (relative path, may be empty).
stm_normalise_toml_path() {
  local path="$1" base
  STM_SPEC_URL_FALLBACK=""
  [ -n "$path" ] || die "$EX_USAGE" "install spec needs a path to a .toml file"
  case "$path" in
    /*) die "$EX_USAGE" "install path may not be absolute" ;;
  esac
  base="${path##*/}"
  case "$base" in
    *.*)
      case "$base" in
        *.toml)
          STM_SPEC_PATH="$path"
          ;;
        *)
          die "$EX_USAGE" "install path must be a .toml file: $path"
          ;;
      esac
      ;;
    *)
      STM_SPEC_PATH="${path}.toml"
      case "$path" in
        palettes/*) : ;;
        *) STM_SPEC_URL_FALLBACK="palettes/${path}.toml" ;;
      esac
      ;;
  esac
}

stm_spec_reject_meta() {
  local spec="$1" ats
  [ -n "$spec" ] || die "$EX_USAGE" "install needs owner/repo/path.toml"
  [ "${#spec}" -le "$STM_SPEC_MAX" ] || die "$EX_USAGE" "install spec is too long"
  case "$spec" in
    *[[:space:]]*) die "$EX_USAGE" "install spec must not contain whitespace" ;;
  esac
  case "$spec" in
    *[\`\$\;\|\&\<\>\(\)\{\}\!\\\'\"\*\?\~\[\]\#]*)
      die "$EX_USAGE" "install spec contains a metacharacter"
      ;;
  esac
  case "$spec" in
    *..*) die "$EX_USAGE" "install spec may not contain .." ;;
    /*) die "$EX_USAGE" "install spec may not be an absolute path" ;;
  esac
  ats=$(printf '%s' "$spec" | tr -cd '@')
  if [ "${#ats}" -gt 1 ]; then
    die "$EX_USAGE" "install spec has more than one @"
  fi
}

stm_build_git_url() {
  local host="$1" owner="$2" repo="$3" ref="$4" path="$5"
  case "$host" in
    github.com)
      printf 'https://raw.githubusercontent.com/%s/%s/%s/%s\n' "$owner" "$repo" "$ref" "$path"
      ;;
    gitlab.com)
      printf 'https://gitlab.com/%s/%s/-/raw/%s/%s\n' "$owner" "$repo" "$ref" "$path"
      ;;
    codeberg.org)
      printf 'https://codeberg.org/%s/%s/raw/branch/%s/%s\n' "$owner" "$repo" "$ref" "$path"
      ;;
    *)
      printf 'https://%s/%s/%s/%s\n' "$host" "$owner" "$repo" "$path"
      ;;
  esac
}

stm_parse_https_spec() {
  local spec="$1" rest host path owner repo kind ref refkind
  rest="${spec#https://}"
  case "$rest" in
    *@*) die "$EX_USAGE" "install spec must not contain userinfo" ;;
  esac
  host="${rest%%/*}"
  if [ "$host" = "$rest" ]; then
    die "$EX_USAGE" "install spec has no path"
  fi
  path="${rest#*/}"
  path="${path%%\?*}"
  path="${path%%#*}"
  stm_validate_fetch_host "$host"
  host=$(stm_lc "$host")
  STM_SPEC_HOST="$host"
  STM_SPEC_REF="HEAD"
  STM_SPEC_URL_FALLBACK=""

  case "$host" in
    github.com)
      owner="${path%%/*}"; path="${path#*/}"
      repo="${path%%/*}"; path="${path#*/}"
      kind="${path%%/*}"; path="${path#*/}"
      stm_validate_git_name "$owner" "owner"
      stm_validate_git_name "$repo" "repo"
      case "$kind" in
        blob | raw)
          ref="${path%%/*}"; path="${path#*/}"
          stm_validate_ref "$ref"
          stm_normalise_toml_path "$path"
          STM_SPEC_REF="$ref"
          STM_SPEC_URL=$(stm_build_git_url github.com "$owner" "$repo" "$ref" "$STM_SPEC_PATH")
          if [ -n "$STM_SPEC_URL_FALLBACK" ]; then
            STM_SPEC_URL_FALLBACK=$(stm_build_git_url github.com "$owner" "$repo" "$ref" "$STM_SPEC_URL_FALLBACK")
          fi
          ;;
        *)
          die "$EX_USAGE" "github URL must be a blob or raw path"
          ;;
      esac
      ;;
    gitlab.com)
      owner="${path%%/*}"; path="${path#*/}"
      repo="${path%%/*}"; path="${path#*/}"
      stm_validate_git_name "$owner" "owner"
      stm_validate_git_name "$repo" "repo"
      case "$path" in
        -/*)
          path="${path#-/*}"
          kind="${path%%/*}"; path="${path#*/}"
          case "$kind" in
            blob | raw)
              ref="${path%%/*}"; path="${path#*/}"
              stm_validate_ref "$ref"
              stm_normalise_toml_path "$path"
              STM_SPEC_REF="$ref"
              STM_SPEC_URL=$(stm_build_git_url gitlab.com "$owner" "$repo" "$ref" "$STM_SPEC_PATH")
              if [ -n "$STM_SPEC_URL_FALLBACK" ]; then
                STM_SPEC_URL_FALLBACK=$(stm_build_git_url gitlab.com "$owner" "$repo" "$ref" "$STM_SPEC_URL_FALLBACK")
              fi
              ;;
            *)
              die "$EX_USAGE" "gitlab URL must be a blob or raw path"
              ;;
          esac
          ;;
        *)
          die "$EX_USAGE" "gitlab URL must contain /-/blob/ or /-/raw/"
          ;;
      esac
      ;;
    codeberg.org)
      owner="${path%%/*}"; path="${path#*/}"
      repo="${path%%/*}"; path="${path#*/}"
      stm_validate_git_name "$owner" "owner"
      stm_validate_git_name "$repo" "repo"
      kind="${path%%/*}"; path="${path#*/}"
      case "$kind" in
        src | raw)
          # src/branch/REF/PATH or raw/branch/REF/PATH (or commit/SHA/PATH)
          refkind="${path%%/*}"; path="${path#*/}"
          ref="${path%%/*}"; path="${path#*/}"
          stm_validate_ref "$ref"
          stm_normalise_toml_path "$path"
          STM_SPEC_REF="$ref"
          case "$refkind" in
            commit)
              STM_SPEC_URL="https://codeberg.org/${owner}/${repo}/raw/commit/${ref}/${STM_SPEC_PATH}"
              ;;
            tag)
              STM_SPEC_URL="https://codeberg.org/${owner}/${repo}/raw/tag/${ref}/${STM_SPEC_PATH}"
              ;;
            branch)
              STM_SPEC_URL=$(stm_build_git_url codeberg.org "$owner" "$repo" "$ref" "$STM_SPEC_PATH")
              ;;
            *)
              die "$EX_USAGE" "codeberg URL kind must be branch, tag, or commit"
              ;;
          esac
          if [ -n "$STM_SPEC_URL_FALLBACK" ]; then
            STM_SPEC_URL_FALLBACK="${STM_SPEC_URL%"$STM_SPEC_PATH"}${STM_SPEC_URL_FALLBACK}"
          fi
          ;;
        *)
          die "$EX_USAGE" "codeberg URL must be a src or raw path"
          ;;
      esac
      ;;
    raw.githubusercontent.com)
      stm_normalise_toml_path "$path"
      STM_SPEC_URL="https://raw.githubusercontent.com/${STM_SPEC_PATH}"
      stm_promote_fallback_url
      ;;
    *)
      stm_normalise_toml_path "$path"
      STM_SPEC_URL="https://${host}/${STM_SPEC_PATH}"
      stm_promote_fallback_url
      ;;
  esac
}

# If STM_SPEC_URL_FALLBACK is still a relative palettes/… path, hang it off
# the same prefix as the primary HTTPS URL.
stm_promote_fallback_url() {
  [ -n "$STM_SPEC_URL_FALLBACK" ] || return 0
  case "$STM_SPEC_URL_FALLBACK" in
    https://*) return 0 ;;
  esac
  case "$STM_SPEC_URL" in
    */"$STM_SPEC_PATH")
      STM_SPEC_URL_FALLBACK="${STM_SPEC_URL%"$STM_SPEC_PATH"}${STM_SPEC_URL_FALLBACK}"
      ;;
  esac
}

stm_parse_locator_spec() {
  local spec="$1" host rest first first_lc owner repo ref path ats allow
  host="github.com"
  rest="$spec"
  first="${spec%%/*}"
  first_lc=$(stm_lc "$first")
  allow=""
  [ -n "$OPT_ALLOW_HOST" ] && allow=$(stm_lc "$OPT_ALLOW_HOST")

  case "$first_lc" in
    localhost | *.localhost)
      stm_validate_fetch_host "$first_lc"
      ;;
    *.*)
      stm_validate_fetch_host "$first_lc"
      host="$first_lc"
      rest="${spec#*/}"
      ;;
    *)
      if [ -n "$allow" ] && [ "$first_lc" = "$allow" ]; then
        stm_validate_fetch_host "$first_lc"
        host="$first_lc"
        rest="${spec#*/}"
      fi
      ;;
  esac

  STM_SPEC_HOST="$host"
  STM_SPEC_URL_FALLBACK=""

  if [ "$host" = "raw.githubusercontent.com" ]; then
    stm_normalise_toml_path "$rest"
    STM_SPEC_REF="HEAD"
    STM_SPEC_URL="https://raw.githubusercontent.com/${STM_SPEC_PATH}"
    return 0
  fi

  case "$host" in
    github.com | gitlab.com | codeberg.org) : ;;
    *)
      stm_normalise_toml_path "$rest"
      STM_SPEC_REF="HEAD"
      STM_SPEC_URL="https://${host}/${STM_SPEC_PATH}"
      return 0
      ;;
  esac

  ats=$(printf '%s' "$rest" | tr -cd '@')
  owner="${rest%%/*}"
  [ "$owner" != "$rest" ] || die "$EX_USAGE" "install needs owner/repo/path.toml"
  rest="${rest#*/}"
  stm_validate_git_name "$owner" "owner"

  if [ "${#ats}" -eq 1 ]; then
    repo="${rest%%/*}"
    [ "$repo" != "$rest" ] || die "$EX_USAGE" "install needs owner/repo/path.toml"
    path="${rest#*/}"
    case "$repo" in
      *@*)
        ref="${repo#*@}"
        repo="${repo%%@*}"
        ;;
      *)
        die "$EX_USAGE" "invalid @ in install spec"
        ;;
    esac
  else
    repo="${rest%%/*}"
    [ "$repo" != "$rest" ] || die "$EX_USAGE" "install needs owner/repo/path.toml"
    path="${rest#*/}"
    ref="HEAD"
  fi
  stm_validate_git_name "$repo" "repo"
  case "$repo" in
    *.git) die "$EX_USAGE" "install spec must not use a .git suffix" ;;
  esac
  stm_validate_ref "$ref"
  stm_normalise_toml_path "$path"
  STM_SPEC_REF="$ref"
  STM_SPEC_URL=$(stm_build_git_url "$host" "$owner" "$repo" "$ref" "$STM_SPEC_PATH")
  if [ -n "$STM_SPEC_URL_FALLBACK" ]; then
    STM_SPEC_URL_FALLBACK=$(stm_build_git_url "$host" "$owner" "$repo" "$ref" "$STM_SPEC_URL_FALLBACK")
  fi
}

# stm_parse_install_spec <spec> — sets STM_SPEC_URL / REF / HOST / PATH.
# Rejects before any URL is built for traversal, schemes, metacharacters, IPs.
stm_parse_install_spec() {
  local spec="$1"
  STM_SPEC_URL=""
  STM_SPEC_URL_FALLBACK=""
  STM_SPEC_REF=""
  STM_SPEC_HOST=""
  STM_SPEC_PATH=""
  stm_spec_reject_meta "$spec"
  case "$spec" in
    [a-zA-Z][a-zA-Z0-9+.-]*:*)
      case "$spec" in
        https://*) stm_parse_https_spec "$spec" ;;
        *) die "$EX_USAGE" "only https is allowed" ;;
      esac
      ;;
    */*)
      stm_parse_locator_spec "$spec"
      ;;
    *)
      die "$EX_USAGE" "install needs owner/repo/path.toml (a slug needs the portal)"
      ;;
  esac
  [ -n "$STM_SPEC_URL" ] || die "$EX_USAGE" "could not resolve install spec"
  case "$STM_SPEC_URL" in
    https://*) : ;;
    *) die "$EX_USAGE" "resolved URL is not https" ;;
  esac
}

# stm_validate_fetch_url <url> — HTTPS, no userinfo, host allowlisted.
# Dies EX_USAGE on refuse (same as spec parse).
stm_validate_fetch_url() {
  local url="$1" rest host
  case "$url" in
    https://*) : ;;
    *) die "$EX_USAGE" "fetch URL is not https: $url" ;;
  esac
  case "$url" in
    https://*@*) die "$EX_USAGE" "fetch URL must not contain userinfo" ;;
  esac
  rest="${url#https://}"
  host="${rest%%/*}"
  host="${host%%:*}"
  stm_validate_fetch_host "$host"
}

# stm_try_fetch <url> <dest> — 0 ok, 22 not found, 23 redirect (Location in dest),
# other = transport error. Does not die. Does not follow redirects.
stm_try_fetch() {
  local url="$1" dest="$2" st hdr code loc
  case "$url" in
    https://*) : ;;
    *) return 1 ;;
  esac
  case "$url" in
    https://*@*) return 1 ;;
  esac
  if [ -n "${STM_FETCH:-}" ]; then
    set +e
    "$STM_FETCH" "$url" "$dest"
    st=$?
    set -e
    return "$st"
  fi
  hdr="${dest}.hdr"
  set +e
  curl -fsS --proto '=https' --proto-redir '=https' --max-redirs 0 \
    --max-time 30 --max-filesize "$STM_LINT_MAX_BYTES" \
    -D "$hdr" -o "$dest" "$url"
  st=$?
  set -e
  code=0
  if [ -f "$hdr" ]; then
    code=$(awk 'BEGIN { c = 0 } /^HTTP\// { c = $2 } END { print c + 0 }' "$hdr")
    if [ "$code" -ge 300 ] && [ "$code" -lt 400 ]; then
      loc=$(awk '
        {
          line = $0
          sub(/\r$/, "", line)
          if (tolower(line) ~ /^location:[ \t]*/) {
            sub(/^[Ll][Oo][Cc][Aa][Tt][Ii][Oo][Nn]:[ \t]*/, "", line)
            print line
            exit
          }
        }' "$hdr")
      rm -f "$hdr"
      printf '%s\n' "$loc" >"$dest"
      return 23
    fi
    rm -f "$hdr"
  fi
  if [ "$st" -eq 22 ] || [ "$code" -eq 404 ]; then
    return 22
  fi
  return "$st"
}

stm_fetch_https() {
  local url="$1" dest="$2" st=0 fallback="${3:-}" hops=0 loc
  while :; do
    stm_validate_fetch_url "$url"
    st=0
    stm_try_fetch "$url" "$dest" || st=$?
    if [ "$st" -eq 23 ]; then
      loc=$(tr -d '\r' <"$dest" | sed -n '1p')
      hops=$((hops + 1))
      if [ "$hops" -ge 4 ]; then
        die "$EX_NETWORK" "too many redirects: $url"
      fi
      url="$loc"
      continue
    fi
    if [ "$st" -eq 22 ] && [ -n "$fallback" ]; then
      st=0
      stm_validate_fetch_url "$fallback"
      stm_try_fetch "$fallback" "$dest" || st=$?
      [ "$st" -eq 0 ] && url="$fallback"
      fallback=""
    fi
    break
  done
  if [ "$st" -eq 22 ]; then
    die "$EX_NOTFOUND" "palette not found at $url"
  fi
  if [ "$st" -ne 0 ]; then
    die "$EX_NETWORK" "fetch failed (exit $st): $url"
  fi
  [ -f "$dest" ] || die "$EX_NETWORK" "fetch wrote nothing: $url"
  # Persist the URL that actually landed so the ledger is not the 404.
  STM_SPEC_URL="$url"
}

# ---------------------------------------------------------------------------
# provenance ledger — $XDG_CONFIG_HOME/stm/installed
# Format (one row per slug; slug-validated fields only):
#   slug<TAB>source-url<TAB>sha256<TAB>ref<TAB>iso8601
# Not a theme file. uninstall drops the matching row.
# ---------------------------------------------------------------------------

stm_ledger_file() {
  local root
  root="${XDG_CONFIG_HOME:-$HOME/.config}"
  printf '%s\n' "$root/stm/installed"
}

stm_sha256() {
  local f="$1"
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$f" | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$f" | awk '{print $1}'
  else
    openssl dgst -sha256 "$f" | awk '{print $NF}'
  fi
}

stm_iso8601() {
  date -u +%Y-%m-%dT%H:%M:%SZ
}

stm_ledger_put() {
  local slug="$1" url="$2" hash="$3" ref="$4" ts="$5"
  local file dir tmp
  validate_slug "$slug"
  file=$(stm_ledger_file)
  dir=$(dirname "$file")
  mkdir -p "$dir"
  mktemp_in "$dir"
  tmp="$STM_TMP"
  if [ -f "$file" ]; then
    awk -F '\t' -v s="$slug" '$1 != s { print }' "$file" >"$tmp"
  else
    : >"$tmp"
  fi
  printf '%s\t%s\t%s\t%s\t%s\n' "$slug" "$url" "$hash" "$ref" "$ts" >>"$tmp"
  commit_tmp "$tmp" "$file"
}

stm_ledger_drop() {
  local slug="$1" file tmp dir
  file=$(stm_ledger_file)
  [ -f "$file" ] || return 0
  dir=$(dirname "$file")
  mktemp_in "$dir"
  tmp="$STM_TMP"
  awk -F '\t' -v s="$slug" '$1 != s { print }' "$file" >"$tmp"
  if [ ! -s "$tmp" ]; then
    rm -f "$tmp" "$file"
    STM_TMP=""
    return 0
  fi
  commit_tmp "$tmp" "$file"
}

# detect_format — inspect the sketchybar dir and decide lua vs bash.
detect_format() {
  local dir="$1" has_lua=0 has_bash=0 f

  [ -d "$dir" ] || die "$EX_CONFIG" "sketchybar config dir does not exist: $dir"

  [ -f "$dir/colors.lua" ] && has_lua=1
  [ -f "$dir/colors_generated.lua" ] && has_lua=1
  if [ "$has_lua" -eq 0 ]; then
    for f in "$dir"/*.lua; do
      if [ -f "$f" ]; then
        has_lua=1
        break
      fi
    done
  fi
  [ -f "$dir/colors.sh" ] && has_bash=1

  # The config-sh pattern: a sourced config.sh with no colors.sh of its own.
  # stm generates a theme snippet instead of rewriting anything in place.
  if [ "$has_bash" -eq 0 ] && [ "$has_lua" -eq 0 ] && [ -f "$dir/config.sh" ]; then
    printf 'config-sh\n'
    return 0
  fi

  if [ "$has_lua" -eq 1 ] && [ "$has_bash" -eq 1 ]; then
    die "$EX_CONFIG" "ambiguous config format in $dir (found both Lua and colors.sh); pass --format lua or --format bash"
  fi
  [ "$has_lua" -eq 1 ] && { printf 'lua\n'; return 0; }
  [ "$has_bash" -eq 1 ] && { printf 'bash\n'; return 0; }

  die "$EX_CONFIG" "could not detect a config format in $dir (expected colors.lua, another .lua file, colors.sh, or config.sh)"
}

resolve_format() {
  local f=""
  if [ -n "$OPT_FORMAT" ]; then
    f="$OPT_FORMAT"
  elif [ -n "${STM_FORMAT:-}" ]; then
    f="$STM_FORMAT"
  elif [ -n "$RESOLVED_CONFIG" ] && f=$(stm_config_get "$RESOLVED_CONFIG" format 2>/dev/null); then
    [ "$f" = "auto" ] && f=""
  fi
  if [ -z "$f" ]; then
    f=$(detect_format "$RESOLVED_DIR")
  fi
  case "$f" in
    lua | bash | config-sh) : ;;
    *) die "$EX_CONFIG" "unknown format \"$f\" (want lua, bash or config-sh)" ;;
  esac
  RESOLVED_FORMAT="$f"
  note "format: $RESOLVED_FORMAT"
}

# detect_lua_dialect <dir> — "nested" if the user's own Lua declares sub-tables
# for bar/popup (the shape where colors.popup.bg must resolve), else "flat".
# The dialect is a property of the colours module, so only colors.lua (and
# colors_user.lua after `stm adopt`) is inspected. Scanning every .lua would
# false-positive on item definitions like `bar = { color = colors.bar_bg }`,
# which is a SketchyBar item, not a palette. When there is no colours module,
# flat is the safe default and --lua-dialect nested is available.
detect_lua_dialect() {
  local f
  for f in "$1/colors.lua" "$1/colors_user.lua"; do
    if [ -f "$f" ] && grep -qE '^[[:space:]]*(bar|popup)[[:space:]]*=[[:space:]]*\{' "$f"; then
      printf 'nested\n'
      return 0
    fi
  done
  printf 'flat\n'
}

resolve_lua_dialect() {
  local d=""
  if [ -n "$OPT_LUA_DIALECT" ]; then
    d="$OPT_LUA_DIALECT"
  elif [ -n "${STM_LUA_DIALECT:-}" ]; then
    d="$STM_LUA_DIALECT"
  elif [ -n "$RESOLVED_CONFIG" ] && d=$(stm_config_get "$RESOLVED_CONFIG" lua_dialect 2>/dev/null); then
    [ "$d" = "auto" ] && d=""
  fi
  if [ -z "$d" ]; then
    d=$(detect_lua_dialect "$RESOLVED_DIR")
  fi
  case "$d" in
    flat | nested) : ;;
    *) die "$EX_CONFIG" "unknown lua dialect \"$d\" (want flat or nested)" ;;
  esac
  RESOLVED_LUA_DIALECT="$d"
  note "lua dialect: $RESOLVED_LUA_DIALECT"
}

# ---------------------------------------------------------------------------
# Writers
# ---------------------------------------------------------------------------

# Keys that the nested Lua dialect lifts out of the flat palette into
# sub-tables: "<flat key>:<table>.<field>".
STM_NESTED_MAP="bar_bg:bar.bg bar_border:bar.border popup_bg:popup.bg popup_border:popup.border"

# The with_alpha helper emitted by the nested dialect.
#
# This is stm's OWN code, a fixed constant. It is never read from a palette:
# palettes are untrusted data and may only ever contribute validated hex
# literals. Emitting a function sourced from palette content would turn
# "install a theme" into "run a stranger's Lua".
STM_WITH_ALPHA='local with_alpha = function(color, alpha)
  if alpha > 1.0 or alpha < 0.0 then
    return color
  end
  return (color & 0x00ffffff) | (math.floor(alpha * 255.0) << 24)
end'

# lua_nested_field <flat-key> — echo "table.field" if the key is nested, else
# nothing.
lua_nested_field() {
  local k="$1" pair
  for pair in $STM_NESTED_MAP; do
    case "$pair" in
      "$k":*) printf '%s\n' "${pair#*:}"; return 0 ;;
    esac
  done
  return 1
}

# write_lua <records> <target>
write_lua() {
  local records="$1" target="$2" dir tmp name slug variant stamp

  dir=$(dirname "$target")
  name=$(stm_records_meta "$records" name)
  slug=$(stm_records_meta "$records" slug)
  variant=$(stm_records_meta "$records" variant_label)
  stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  mktemp_in "$dir"
  tmp="$STM_TMP"
  {
    printf -- '-- Generated by stm (sketchybar-theme-manager). DO NOT EDIT.\n'
    # shellcheck disable=SC2016  # literal backticks inside a Lua comment
    printf -- '-- Edit your palette .toml and re-run `stm apply` instead.\n'
    printf -- '-- theme: %s\n' "$slug"
    printf -- '-- name: %s\n' "$name"
    printf -- '-- variant: %s\n' "$variant"
    printf -- '-- dialect: %s\n' "$RESOLVED_LUA_DIALECT"
    printf -- '-- generated: %s\n' "$stamp"
    printf -- '\n'

    if [ "$RESOLVED_LUA_DIALECT" = "nested" ]; then
      write_lua_nested "$records"
    else
      write_lua_flat "$records"
    fi
  } >"$tmp"

  commit_tmp "$tmp" "$target"
}

# write_lua_flat <records> — one flat table of hex literals.
write_lua_flat() {
  local records="$1"
  printf -- 'return {\n'
  stm_records_colors "$records" | while IFS=$'\t' read -r k v; do
    printf -- '  %s = %s,\n' "$k" "$v"
  done
  printf -- '}\n'
}

# write_lua_nested <records> — the shape used by configs that `return generated`
# wholesale: sub-tables for bar/popup plus the with_alpha helper, so
# colors.popup.bg and colors.with_alpha() resolve.
write_lua_nested() {
  local records="$1" k v field tbl

  printf -- '%s\n\n' "$STM_WITH_ALPHA"
  printf -- 'return {\n'

  # Top-level scalars first, in sorted order, skipping anything nested.
  stm_records_colors "$records" | while IFS=$'\t' read -r k v; do
    if lua_nested_field "$k" >/dev/null; then continue; fi
    printf -- '  %s = %s,\n' "$k" "$v"
  done

  # Then each sub-table, in the order declared by STM_NESTED_MAP.
  for tbl in bar popup; do
    printf -- '\n  %s = {\n' "$tbl"
    stm_records_colors "$records" | while IFS=$'\t' read -r k v; do
      field=$(lua_nested_field "$k") || continue
      case "$field" in
        "$tbl".*) printf -- '    %s = %s,\n' "${field#*.}" "$v" ;;
      esac
    done
    printf -- '  },\n'
  done

  printf -- '\n  with_alpha = with_alpha,\n'
  printf -- '}\n'
}

# ---------------------------------------------------------------------------
# Templates
#
# If the user drops <template_dir>/<format>.tpl into their own config tree, it
# replaces the built-in writer entirely. That is the escape hatch for configs
# whose layout stm does not model.
#
# A template is TRUSTED: it lives in the user's own directory and may contain
# whatever Lua or shell they like. A palette is NOT trusted, and the only thing
# it ever contributes to a render is a value already validated as
# ^0x[0-9a-f]{8}$. stm never installs a template from a palette or the network.
#
# Substitution is a single awk pass. Nothing is eval'd and the template text is
# never expanded by the shell.
#
# A placeholder is exactly {{identifier}} where identifier is [a-z_][a-z0-9_]*.
# Anything else after {{ is literal text and is passed through untouched, which
# is what lets a Lua template contain a nested constructor like {{1,2},{3,4}}.
# Write {{{{ for a literal {{.
# ---------------------------------------------------------------------------

# shellcheck disable=SC2016  # awk source
STM_TEMPLATE_AWK='
function fail(msg) {
  printf("%s: %s: line %d: %s\n", prog, tplname, FNR, msg) > "/dev/stderr"
  bad = 1
  exit 1
}
function is_block(nm) {
  return (nm == "colors_lua" || nm == "colors_bash" || nm == "extras_lua" ||
          nm == "extras_bash" || nm == "children_lua" || nm == "with_alpha" ||
          nm == "layout_lua" || nm == "items_lua" || nm == "layout_bash")
}
# Multi-line expansions are read from files. awk -v cannot carry a newline in
# its value, so they cannot be passed on the command line.
function readblock(nm,   f, l, acc, first) {
  if (nm in blockcache) return blockcache[nm]
  f = blockdir "/" nm
  acc = ""
  first = 1
  while ((getline l < f) > 0) {
    if (first) { acc = l; first = 0 } else acc = acc "\n" l
  }
  close(f)
  blockcache[nm] = acc
  return acc
}
function lookup(nm) {
  if (nm == "name") return m_name
  if (nm == "slug") return m_slug
  if (nm == "variant_label") return m_variant
  if (nm == "generated") return m_generated
  if (is_block(nm)) return readblock(nm)
  if (nm in map) return map[nm]
  fail("unknown placeholder {{" nm "}}")
}
BEGIN { SUBSEP = "\034"; bad = 0 }

NR == FNR { if (NF >= 2) map[$1] = $2; next }

{
  line = $0
  sub(/\r$/, "", line)

  # Protect the {{{{ escape before any substitution happens.
  gsub(/\{\{\{\{/, "\001", line)

  out = ""
  while (1) {
    p = index(line, "{{")
    if (p == 0) break
    out = out substr(line, 1, p - 1)
    rest = substr(line, p + 2)
    q = index(rest, "}}")
    nm = (q == 0) ? "" : substr(rest, 1, q - 1)
    if (q > 0 && nm ~ /^[a-z_][a-z0-9_]*$/) {
      out = out lookup(nm)
      line = substr(rest, q + 2)
    } else {
      # Not a placeholder: emit the braces literally and keep scanning.
      out = out "{{"
      line = rest
    }
  }
  out = out line
  gsub(/\001/, "{{", out)
  print out
}
'

# template_dir — where user templates live. Relative paths resolve inside the
# SketchyBar config dir.
template_dir() {
  local d="stm/templates"
  if [ -n "$RESOLVED_CONFIG" ]; then
    local configured
    if configured=$(stm_config_section_get "$RESOLVED_CONFIG" output template_dir); then
      d="$configured"
    fi
  fi
  d=$(expand_tilde "$d")
  case "$d" in
    /*) printf '%s\n' "$d" ;;
    *) printf '%s\n' "$RESOLVED_DIR/$d" ;;
  esac
}

# find_template <format> — echo the template path, or fail if there is none.
find_template() {
  local f="$1" dir
  dir=$(template_dir)
  [ -f "$dir/$f.tpl" ] || return 1
  printf '%s\n' "$dir/$f.tpl"
}

# render_template <records> <template> <target> — write the rendered template
# to <target>, atomically.
render_template() {
  local records="$1" tpl="$2" target="$3"
  local dir tmp blk name slug variant stamp

  dir=$(dirname "$target")
  name=$(stm_records_meta "$records" name)
  slug=$(stm_records_meta "$records" slug)
  variant=$(stm_records_meta "$records" variant_label)
  stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  blk=$(mktemp -d "${TMPDIR:-/tmp}/.stm-blk.XXXXXX") ||
    die "$EX_CONFIG" "could not create a temporary directory"
  STM_TMPDIRS="$STM_TMPDIRS
$blk"

  stm_records_colors "$records" >"$blk/map"
  stm_records_colors "$records" | awk -F"\t" '{ printf("  %s = %s,\n", $1, $2) }' >"$blk/colors_lua"
  stm_records_colors "$records" |
    awk -F"\t" '{ k = toupper($1); printf("export %s=%s\n", k, $2) }' >"$blk/colors_bash"
  stm_records_extras "$records" | awk -F"\t" '{ printf("  %s = %s,\n", $1, $2) }' >"$blk/extras_lua"
  stm_records_extras "$records" |
    awk -F"\t" '{ k = toupper($1); printf("export %s=%s\n", k, $2) }' >"$blk/extras_bash"
  lua_children_block "$records" >"$blk/children_lua"
  printf '%s\n' "$STM_WITH_ALPHA" >"$blk/with_alpha"
  layout_lua_block "$records" >"$blk/layout_lua"
  items_lua_block "$records" >"$blk/items_lua"
  layout_bash_block "$records" >"$blk/layout_bash"
  template_layout_map "$records" >>"$blk/map"

  mktemp_in "$dir"
  tmp="$STM_TMP"

  if ! awk -v prog="$PROGNAME" -v tplname="$tpl" -v blockdir="$blk" \
    -v m_name="$name" -v m_slug="$slug" -v m_variant="$variant" -v m_generated="$stamp" \
    "$STM_TEMPLATE_AWK" "$blk/map" "$tpl" >"$tmp"; then
    rm -rf "$blk"
    die "$EX_INVALID" "template render failed: $tpl"
  fi

  rm -rf "$blk"
  commit_tmp "$tmp" "$target"
}

# render_template_check <records> <template> — render to nowhere, purely to see
# whether every placeholder resolves. Writes no file.
render_template_check() {
  local records="$1" tpl="$2" blk rcode=0

  blk=$(mktemp -d "${TMPDIR:-/tmp}/.stm-blk.XXXXXX") || return 1
  STM_TMPDIRS="$STM_TMPDIRS
$blk"
  stm_records_colors "$records" >"$blk/map"
  stm_records_colors "$records" | awk -F"\t" '{ printf("  %s = %s,\n", $1, $2) }' >"$blk/colors_lua"
  stm_records_colors "$records" |
    awk -F"\t" '{ k = toupper($1); printf("export %s=%s\n", k, $2) }' >"$blk/colors_bash"
  stm_records_extras "$records" | awk -F"\t" '{ printf("  %s = %s,\n", $1, $2) }' >"$blk/extras_lua"
  stm_records_extras "$records" |
    awk -F"\t" '{ k = toupper($1); printf("export %s=%s\n", k, $2) }' >"$blk/extras_bash"
  lua_children_block "$records" >"$blk/children_lua"
  printf '%s\n' "$STM_WITH_ALPHA" >"$blk/with_alpha"
  layout_lua_block "$records" >"$blk/layout_lua"
  items_lua_block "$records" >"$blk/items_lua"
  layout_bash_block "$records" >"$blk/layout_bash"
  template_layout_map "$records" >>"$blk/map"

  awk -v prog="$PROGNAME" -v tplname="$tpl" -v blockdir="$blk" \
    -v m_name="x" -v m_slug="x" -v m_variant="x" -v m_generated="x" \
    "$STM_TEMPLATE_AWK" "$blk/map" "$tpl" >/dev/null 2>&1 || rcode=1

  rm -rf "$blk"
  return "$rcode"
}

# template_layout_map <records> — extra map rows so {{bar_position}} and
# {{position}} resolve. Missing keys stay absent and are a hard error if used.
template_layout_map() {
  local records="$1" k v
  stm_records_layout "$records" | while IFS=$'\t' read -r k v; do
    [ -n "$k" ] || continue
    printf '%s\t%s\n' "$k" "$v"
    printf 'bar_%s\t%s\n' "$k" "$v"
  done
}

layout_lua_block() {
  local records="$1" k v
  stm_records_layout "$records" | while IFS=$'\t' read -r k v; do
    [ -n "$k" ] || continue
    if layout_is_int "$k"; then
      printf '    %s = %s,\n' "$k" "$v"
    else
      printf '    %s = "%s",\n' "$k" "$v"
    fi
  done
}

items_lua_block() {
  local records="$1" k v
  stm_records_items "$records" | while IFS=$'\t' read -r k v; do
    [ -n "$k" ] || continue
    printf '    { name = "%s", position = "%s" },\n' "$k" "$v"
  done
}

layout_bash_block() {
  local records="$1" k v uk
  stm_records_layout "$records" | while IFS=$'\t' read -r k v; do
    [ -n "$k" ] || continue
    # shellcheck disable=SC2018,SC2019
    printf 'export BAR_%s=%s\n' "$(printf '%s' "$k" | tr 'a-z' 'A-Z')" "$v"
  done
  stm_records_items "$records" | while IFS=$'\t' read -r k v; do
    [ -n "$k" ] || continue
    uk=$(printf '%s' "$k" | tr 'a-z.' 'A-Z_')
    printf 'export ITEM_%s=%s\n' "$uk" "$v"
  done
}

# lua_children_block <records> — the bar/popup sub-tables, for {{children_lua}}.
lua_children_block() {
  local records="$1" tbl k v field
  for tbl in bar popup; do
    printf '  %s = {\n' "$tbl"
    stm_records_colors "$records" | while IFS=$'\t' read -r k v; do
      field=$(lua_nested_field "$k") || continue
      case "$field" in
        "$tbl".*) printf '    %s = %s,\n' "${field#*.}" "$v" ;;
      esac
    done
    printf '  },\n'
  done
}

# The awk program that performs the in-place colors.sh value swap.
#
# Pass 1 (NR==FNR) loads "KEY<TAB>value" pairs. Pass 2 rewrites matching
# assignment lines, replacing ONLY the value token and leaving indentation,
# `export`, quoting style and trailing comments byte-identical.
# shellcheck disable=SC2016  # this is awk source; $ and " are awk syntax, not shell
STM_SHELL_AWK='
function is_hex8(s,   i, c) {
  if (length(s) != 8) return 0
  for (i = 1; i <= 8; i++) {
    c = substr(s, i, 1)
    if (c !~ /[0-9a-fA-F]/) return 0
  }
  return 1
}
BEGIN { FS = "\t"; nout = 0; changed = 0 }

# Pass 1: the palette, already uppercased by the caller.
NR == FNR { if (NF >= 2) map[$1] = $2; next }

# Pass 2: the users colors.sh
{
  line = $0

  # Track and drop any previous stm header lines; they are re-emitted in END.
  if (line ~ /^#[ \t]*stm-(theme|name):/) { next }

  pos = index(line, "=")
  if (pos < 2) { out[++nout] = line; next }

  head = substr(line, 1, pos)
  tail = substr(line, pos + 1)

  # The variable name: strip indentation and an optional `export`.
  nm = substr(line, 1, pos - 1)
  sub(/^[ \t]*/, "", nm)
  sub(/^export[ \t]+/, "", nm)
  sub(/[ \t]+$/, "", nm)
  if (nm !~ /^[A-Za-z_][A-Za-z0-9_]*$/) { out[++nout] = line; next }
  if (!(nm in map)) { out[++nout] = line; next }

  # The value: optional quote, 0x, exactly 8 hex digits, matching quote, then
  # end-of-line / whitespace / comment. Anything else is left alone -- this is
  # what stops a 10-digit literal from being half-rewritten.
  t = tail
  q = ""
  c = substr(t, 1, 1)
  if (c == "\"" || c == "'"'"'") { q = c; t = substr(t, 2) }

  if (substr(t, 1, 2) != "0x" && substr(t, 1, 2) != "0X") { out[++nout] = line; next }
  hex = substr(t, 3, 8)
  if (!is_hex8(hex)) { out[++nout] = line; next }

  after = substr(t, 11)
  if (q != "") {
    if (substr(after, 1, 1) != q) { out[++nout] = line; next }
    after = substr(after, 2)
  }
  # \r is allowed as a terminator so a CRLF file still gets swapped; it stays in
  # `after`, so the line keeps its original ending.
  if (after != "" && after !~ /^[ \t\r]/ && substr(after, 1, 1) != "#") {
    out[++nout] = line
    next
  }

  out[++nout] = head q map[nm] q after
  changed++
  seen[nm] = 1
}

END {
  # Re-emit a single header block, after a shebang if the file has one.
  start = 1
  if (nout >= 1 && out[1] ~ /^#!/) {
    print out[1]
    start = 2
  }
  print "# stm-theme: " theme_slug
  print "# stm-name: " theme_name
  for (i = start; i <= nout; i++) print out[i]

  if (append_missing == "1") {
    first = 1
    n = split(all_keys, ks, " ")
    for (i = 1; i <= n; i++) {
      k = ks[i]
      if (k in seen) continue
      if (!(k in map)) continue
      if (first) {
        print ""
        print "# --- added by stm (keys absent from the original file) ---"
        first = 0
      }
      print "export " k "=" map[k]
    }
  }

  printf("%d\n", changed) > "/dev/stderr"
}
'

# write_bash <records> <target>
write_bash() {
  local records="$1" target="$2" dir tmp mapfile_path name slug backup all_keys

  [ -f "$target" ] || die "$EX_CONFIG" "no colors.sh found at $target"

  dir=$(dirname "$target")
  name=$(stm_records_meta "$records" name)
  slug=$(stm_records_meta "$records" slug)

  # Uppercase the palette keys once, here, using tr (bash 3.2 has no ${v^^}).
  mktemp_in "$dir"
  mapfile_path="$STM_TMP"
  stm_records_colors "$records" | while IFS=$'\t' read -r k v; do
    # Keys are already validated as [a-z][a-z0-9_]*, and LC_ALL=C is in force,
    # so an explicit ASCII range is exactly right here.
    # shellcheck disable=SC2018,SC2019
    printf '%s\t%s\n' "$(printf '%s' "$k" | tr 'a-z' 'A-Z')" "$v"
  done >"$mapfile_path"

  all_keys=$(cut -f1 "$mapfile_path" | tr '\n' ' ')

  # The pristine backup: taken once, never overwritten. This is the "undo
  # everything" copy, so switching themes later must not disturb it.
  backup="$target.stm-backup"
  if [ ! -f "$backup" ]; then
    cp -p "$target" "$backup"
    note "backup written: $backup"
  fi

  # --backup-each additionally keeps a rolling timestamped copy, so a single
  # bad apply can be undone without going all the way back to pristine. Only
  # the newest few are kept; they would otherwise accumulate forever.
  if [ "$OPT_BACKUP_EACH" -eq 1 ]; then
    local stamp keep n bak
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    # date resolves to the second, so two applies inside one second would
    # otherwise overwrite the same backup. Disambiguate with a counter.
    bak="$target.stm-bak-$stamp"
    n=1
    while [ -e "$bak" ] && [ "$n" -lt 100 ]; do
      bak="$target.stm-bak-$stamp-$n"
      n=$((n + 1))
    done
    cp -p "$target" "$bak"
    note "backup written: $bak"
    # The names are timestamped, so a lexical sort is chronological.
    keep=$(find "$dir" -maxdepth 1 -type f -name "$(basename "$target").stm-bak-*" |
      sort | wc -l | tr -d ' ')
    if [ "$keep" -gt 5 ]; then
      find "$dir" -maxdepth 1 -type f -name "$(basename "$target").stm-bak-*" |
        sort | head -n $((keep - 5)) |
        while IFS= read -r old_bak; do
          [ -n "$old_bak" ] && rm -f "$old_bak"
        done
    fi
  fi

  mktemp_in "$dir"
  tmp="$STM_TMP"
  awk -v theme_slug="$slug" \
    -v theme_name="$name" \
    -v append_missing="$OPT_APPEND_MISSING" \
    -v all_keys="$all_keys" \
    "$STM_SHELL_AWK" "$mapfile_path" "$target" >"$tmp" 2>/dev/null

  rm -f "$mapfile_path"
  commit_tmp "$tmp" "$target"
}

# validate_output_name <value> <config-key> — [output] is the only config value
# that decides a write *path*, so it is held to the same standard as a slug: a
# bare filename inside the config dir, never a path.
validate_output_name() {
  local v="$1" key="$2"
  case "$v" in
    "" | "." | "..") die "$EX_CONFIG" "[output] $key is empty or invalid" ;;
    */*) die "$EX_CONFIG" "[output] $key must be a bare filename, not a path: \"$v\"" ;;
    .*) die "$EX_CONFIG" "[output] $key may not start with a dot: \"$v\"" ;;
  esac
  case "$v" in
    *[!A-Za-z0-9._-]*)
      die "$EX_CONFIG" "[output] $key has invalid characters: \"$v\" (allowed: A-Z a-z 0-9 . _ -)"
      ;;
  esac
  # Never let stm be pointed at files it must not own.
  case "$v" in
    colors.lua | colors_user.lua | .stm-state | .stm-manifest | stm.config.toml | .stm-backups)
      die "$EX_CONFIG" "[output] $key may not be \"$v\" — stm must not own that file"
      ;;
  esac
  printf '%s\n' "$v"
}

# write_config_sh <records> <target> — a standalone, sourceable theme snippet.
# Nothing existing is modified: the user points one `source` line at it.
write_config_sh() {
  local records="$1" target="$2" dir tmp name slug stamp k v

  dir=$(dirname "$target")
  mkdir -p "$dir"
  name=$(stm_records_meta "$records" name)
  slug=$(stm_records_meta "$records" slug)
  stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  mktemp_in "$dir"
  tmp="$STM_TMP"
  {
    printf '#!/usr/bin/env bash\n'
    printf '# Generated by stm (sketchybar-theme-manager). DO NOT EDIT.\n'
    printf '# stm-theme: %s\n' "$slug"
    printf '# stm-name: %s\n' "$name"
    printf '# generated: %s\n\n' "$stamp"
    stm_records_colors "$records" | while IFS=$'\t' read -r k v; do
      # shellcheck disable=SC2018,SC2019  # ASCII keys, LC_ALL=C
      printf 'export %s=%s\n' "$(printf '%s' "$k" | tr 'a-z' 'A-Z')" "$v"
    done
  } >"$tmp"

  commit_tmp "$tmp" "$target"
}

# diff_against_target <records> <target> <format> — print `key old -> new` for
# every key whose value would change, so --dry-run answers "what will this do"
# rather than just "what is in the palette".
diff_against_target() {
  local records="$1" target="$2" fmt="$3" blk
  blk=$(mktemp -d "${TMPDIR:-/tmp}/.stm-blk.XXXXXX") || return 0
  STM_TMPDIRS="$STM_TMPDIRS
$blk"

  stm_records_colors "$records" >"$blk/new"
  if [ "$fmt" = "lua" ]; then
    awk '{ line = $0
           sub(/^[ \t]*/, "", line)
           if (line !~ /^[a-z][a-z0-9_]*[ \t]*=[ \t]*0x[0-9a-f]+,?$/) next
           k = line; sub(/[ \t]*=.*$/, "", k)
           v = line; sub(/^[^=]*=[ \t]*/, "", v); sub(/,$/, "", v)
           printf("%s\t%s\n", k, v) }' "$target" | sort >"$blk/old"
  else
    awk '{ line = $0
           sub(/^[ \t]*/, "", line); sub(/^export[ \t]+/, "", line)
           sub(/[ \t]*#.*$/, "", line)
           if (line !~ /^[A-Z][A-Z0-9_]*=["'"'"']?0x[0-9a-fA-F]+["'"'"']?$/) next
           k = line; sub(/=.*$/, "", k)
           v = line; sub(/^[^=]*=/, "", v); gsub(/["'"'"']/, "", v)
           printf("%s\t%s\n", tolower(k), tolower(v)) }' "$target" | sort >"$blk/old"
  fi

  awk -F'\t' '
    NR == FNR { old[$1] = $2; next }
    { if (!($1 in old)) printf("    %-22s (new)      -> %s\n", $1, $2)
      else if (old[$1] != $2) printf("    %-22s %s -> %s\n", $1, old[$1], $2) }
  ' "$blk/old" "$blk/new"

  rm -rf "$blk"
}

# target_path <format> — where the given format writes. [output] may rename the
# destination, but only within the config dir.
target_path() {
  local fmt="$1" name=""
  case "$fmt" in
    lua) name="colors_generated.lua" ;;
    bash) name="colors.sh" ;;
    config-sh)
      # A per-theme snippet, not a file stm overwrites in place.
      local sdir slugname
      sdir="config-examples"
      if [ -n "$RESOLVED_CONFIG" ]; then
        local configured
        if configured=$(stm_config_section_get "$RESOLVED_CONFIG" output theme_dir); then
          sdir=$(validate_output_name "$configured" theme_dir)
        fi
      fi
      slugname="${STM_TARGET_SLUG:-theme}"
      printf '%s\n' "$RESOLVED_DIR/$sdir/$slugname.sh"
      return 0
      ;;
    *) return 1 ;;
  esac
  if [ -n "$RESOLVED_CONFIG" ]; then
    local configured
    if configured=$(stm_config_section_get "$RESOLVED_CONFIG" output "$fmt"); then
      name=$(validate_output_name "$configured" "$fmt")
    fi
  fi
  printf '%s\n' "$RESOLVED_DIR/$name"
}

# layout_path <format> — sibling generated overlay for [layout] / [items].
# Bare filename, same [output] rules as colours. Default depends on format.
layout_path() {
  local fmt="$1" name=""
  case "$fmt" in
    lua) name="layout_generated.lua" ;;
    bash | config-sh) name="layout.sh" ;;
    *) return 1 ;;
  esac
  if [ -n "$RESOLVED_CONFIG" ]; then
    local configured
    if configured=$(stm_config_section_get "$RESOLVED_CONFIG" output layout); then
      name=$(validate_output_name "$configured" layout)
    fi
  fi
  printf '%s\n' "$RESOLVED_DIR/$name"
}

# write_layout <records> <format> — write the overlay if the palette carries
# any layout or item rows. Colour-only palettes leave an existing file alone.
write_layout() {
  local records="$1" fmt="$2" target
  stm_records_has_layout "$records" || return 0
  target=$(layout_path "$fmt") || return 0
  if [ -L "$target" ]; then
    local real
    real=$(resolve_symlinks "$target")
    if [ -e "$real" ] && [ ! -f "$real" ]; then
      die "$EX_CONFIG" "$target is a symlink to a non-regular file ($real); refusing to write"
    fi
    target="$real"
  fi
  assert_writable_target "$target"
  case "$fmt" in
    lua) write_layout_lua "$records" "$target" ;;
    bash | config-sh) write_layout_sh "$records" "$target" ;;
  esac
}

write_layout_lua() {
  local records="$1" target="$2" dir tmp name slug stamp k v

  dir=$(dirname "$target")
  name=$(stm_records_meta "$records" name)
  slug=$(stm_records_meta "$records" slug)
  stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  mktemp_in "$dir"
  tmp="$STM_TMP"
  {
    printf -- '-- Generated by stm (sketchybar-theme-manager). DO NOT EDIT.\n'
    # shellcheck disable=SC2016  # literal backticks inside a Lua comment
    printf -- '-- Edit your palette .toml and re-run `stm apply` instead.\n'
    printf -- '-- theme: %s\n' "$slug"
    printf -- '-- name: %s\n' "$name"
    printf -- '-- generated: %s\n' "$stamp"
    printf -- '\n'
    printf -- 'return {\n'
    printf -- '  bar = {\n'
    stm_records_layout "$records" | while IFS=$'\t' read -r k v; do
      [ -n "$k" ] || continue
      if layout_is_int "$k"; then
        printf -- '    %s = %s,\n' "$k" "$v"
      else
        printf -- '    %s = "%s",\n' "$k" "$v"
      fi
    done
    printf -- '  },\n'
    printf -- '  items = {\n'
    stm_records_items "$records" | while IFS=$'\t' read -r k v; do
      [ -n "$k" ] || continue
      printf -- '    { name = "%s", position = "%s" },\n' "$k" "$v"
    done
    printf -- '  },\n'
    printf -- '  position_of = {\n'
    stm_records_items "$records" | while IFS=$'\t' read -r k v; do
      [ -n "$k" ] || continue
      printf -- '    %s = "%s",\n' "$k" "$v"
    done
    printf -- '  },\n'
    printf -- '}\n'
  } >"$tmp"

  commit_tmp "$tmp" "$target"
}

write_layout_sh() {
  local records="$1" target="$2" dir tmp name slug stamp k v
  local left="" center="" right="" uk

  dir=$(dirname "$target")
  name=$(stm_records_meta "$records" name)
  slug=$(stm_records_meta "$records" slug)
  stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  mktemp_in "$dir"
  tmp="$STM_TMP"
  {
    printf '#!/usr/bin/env bash\n'
    printf '# Generated by stm (sketchybar-theme-manager). DO NOT EDIT.\n'
    printf '# stm-theme: %s\n' "$slug"
    printf '# stm-name: %s\n' "$name"
    printf '# generated: %s\n\n' "$stamp"
    stm_records_layout "$records" | while IFS=$'\t' read -r k v; do
      [ -n "$k" ] || continue
      # shellcheck disable=SC2018,SC2019  # ASCII keys, LC_ALL=C
      printf 'export BAR_%s=%s\n' "$(printf '%s' "$k" | tr 'a-z' 'A-Z')" "$v"
    done
    stm_records_items "$records" | while IFS=$'\t' read -r k v; do
      [ -n "$k" ] || continue
      uk=$(printf '%s' "$k" | tr 'a-z.' 'A-Z_')
      printf 'export ITEM_%s=%s\n' "$uk" "$v"
    done
  } >"$tmp"

  # Order lists are built in the parent so the while-subshell cannot hide them.
  left=""
  center=""
  right=""
  while IFS=$'\t' read -r k v; do
    [ -n "$k" ] || continue
    case "$v" in
      left) left="$left$k " ;;
      center) center="$center$k " ;;
      right) right="$right$k " ;;
    esac
  done <<EOF
$(stm_records_items "$records")
EOF
  {
    printf 'export ITEM_ORDER_LEFT="%s"\n' "${left% }"
    printf 'export ITEM_ORDER_CENTER="%s"\n' "${center% }"
    printf 'export ITEM_ORDER_RIGHT="%s"\n' "${right% }"
  } >>"$tmp"

  commit_tmp "$tmp" "$target"
}

# reset_layout <format> — delete the generated overlay. Used by --reset-layout.
reset_layout_file() {
  local fmt="$1" target
  target=$(layout_path "$fmt") || return 0
  if [ -L "$target" ]; then
    target=$(resolve_symlinks "$target")
  fi
  [ -f "$target" ] || return 0
  rm -f "$target"
  note "removed layout overlay: $target"
}

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------

state_file() { printf '%s\n' "$RESOLVED_DIR/.stm-state"; }

write_state() {
  local slug="$1" sf tmp
  sf=$(state_file)
  mktemp_in "$RESOLVED_DIR"
  tmp="$STM_TMP"
  printf '%s\n' "$slug" >"$tmp"
  commit_tmp "$tmp" "$sf"
}

read_state() {
  local sf gen sh
  sf=$(state_file)
  if [ -f "$sf" ]; then
    head -n 1 "$sf" | tr -d '[:space:]'
    return 0
  fi
  gen="$RESOLVED_DIR/colors_generated.lua"
  if [ -f "$gen" ]; then
    awk '/^-- theme:/ { print $3; exit }' "$gen"
    return 0
  fi
  sh="$RESOLVED_DIR/colors.sh"
  if [ -f "$sh" ]; then
    awk '/^#[ \t]*stm-theme:/ { print $3; exit }' "$sh"
    return 0
  fi
  return 1
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_list() {
  local d bundled active seen_file listing slug name src marker workdir note
  bundled=$(bundled_palette_dir 2>/dev/null || true)
  active=$(read_state 2>/dev/null || true)

  # A private directory rather than two loose files in $TMPDIR, so nothing is
  # left at a predictable path if we are killed mid-run.
  workdir=$(mktemp -d "${TMPDIR:-/tmp}/.stm-list.XXXXXX") ||
    die "$EX_CONFIG" "could not create a temporary directory"
  STM_TMPDIRS="$STM_TMPDIRS
$workdir"
  seen_file="$workdir/seen"
  listing="$workdir/listing"
  : >"$seen_file"
  : >"$listing"

  while IFS= read -r d; do
    [ -n "$d" ] || continue
    [ -d "$d" ] || continue
    for f in "$d"/*.toml; do
      [ -f "$f" ] || continue
      slug=$(basename "$f" .toml)
      # Highest-precedence directory wins for a given slug.
      if grep -qxF -- "$slug" "$seen_file" 2>/dev/null; then
        continue
      fi
      printf '%s\n' "$slug" >>"$seen_file"
      name=$(awk '
        /^[ \t]*name[ \t]*=/ {
          v = $0; sub(/^[^=]*=[ \t]*"/, "", v); sub(/".*$/, "", v); print v; exit
        }' "$f")
      [ -n "$name" ] || name="$slug"
      if [ -n "$bundled" ] && [ "$d" = "$bundled" ]; then src="bundled"; else src="user"; fi
      printf '%s\t%s\t%s\n' "$slug" "$name" "$src" >>"$listing"
    done
  done <<EOF
$(palette_dirs)
EOF

  if [ ! -s "$listing" ]; then
    err "no palettes found (searched: $(palette_dirs | tr '\n' ' '))"
    return 0
  fi

  sort "$listing" | while IFS=$'\t' read -r slug name src; do
    if [ "$OPT_PORCELAIN" -eq 1 ]; then
      if [ "$slug" = "$active" ]; then
        printf '%s\t%s\t%s\t1\n' "$slug" "$name" "$src"
      else
        printf '%s\t%s\t%s\t0\n' "$slug" "$name" "$src"
      fi
    else
      if [ "$slug" = "$active" ]; then marker="*"; else marker=" "; fi
      printf '%s %-24s %-24s (%s)\n' "$marker" "$slug" "$name" "$src"
      if [ "$OPT_VERBOSE" -eq 1 ] && note=$(theme_note "$slug"); then
        printf '    %s\n' "$note"
      fi
    fi
  done
}

cmd_apply() {
  local slug="$1" file records target name reloaded note_text tpl

  file=$(find_palette "$slug") || {
    err "theme not found: $slug"
    err "available themes:"
    OPT_PORCELAIN=0 cmd_list >&2 || true
    exit "$EX_NOTFOUND"
  }

  records=$(stm_parse_palette "$file")
  records=$(apply_mapping "$records")
  records=$(apply_alpha "$records")

  # The file name and the declared slug must agree, or `stm current` lies.
  local declared
  declared=$(stm_records_meta "$records" slug)
  if [ "$declared" != "$slug" ]; then
    die "$EX_INVALID" "palette $file declares slug \"$declared\" but is filed as \"$slug\""
  fi

  [ -d "$RESOLVED_DIR" ] || die "$EX_CONFIG" "sketchybar config dir does not exist: $RESOLVED_DIR"
  resolve_format
  [ "$RESOLVED_FORMAT" = "lua" ] && resolve_lua_dialect
  STM_TARGET_SLUG="$slug"
  target=$(target_path "$RESOLVED_FORMAT")
  name=$(stm_records_meta "$records" name)

  if [ "$OPT_DRY_RUN" -eq 1 ]; then
    info "would apply $name ($slug)"
    info "  format: $RESOLVED_FORMAT"
    info "  target: $target"
    if [ "$RESOLVED_FORMAT" = "bash" ]; then
      info "  backup: $target.stm-backup"
    fi
    if [ -f "$target" ]; then
      info "  changes:"
      diff_against_target "$records" "$target" "$RESOLVED_FORMAT"
    else
      info "  colours:"
      stm_records_colors "$records" | while IFS=$'\t' read -r k v; do
        info "    $k = $v"
      done
    fi
    return 0
  fi

  # Follow a symlinked target so `stow`-style dotfiles keep working, but refuse
  # anything that is not a plain file.
  if [ -L "$target" ]; then
    local real
    real=$(resolve_symlinks "$target")
    if [ -e "$real" ] && [ ! -f "$real" ]; then
      die "$EX_CONFIG" "$target is a symlink to a non-regular file ($real); refusing to write"
    fi
    note "target is a symlink -> $real"
    target="$real"
  fi

  # config-sh writes a per-theme snippet into its own directory, which will not
  # exist on the first apply.
  if [ "$RESOLVED_FORMAT" = "config-sh" ]; then
    mkdir -p "$(dirname "$target")"
  fi

  # Check up front, so we never take a backup or do any work for a write that
  # is going to be refused anyway.
  assert_writable_target "$target"

  # Snapshot stm-owned state before the first destructive write. Colour-only
  # auto snapshots; --all is never implicit.
  auto_backup_owned

  # A user template, when present, replaces the built-in writer for that format.
  if tpl=$(find_template "$RESOLVED_FORMAT"); then
    note "rendering via template: $tpl"
    render_template "$records" "$tpl" "$target"
  else
    case "$RESOLVED_FORMAT" in
      lua) write_lua "$records" "$target" ;;
      bash) write_bash "$records" "$target" ;;
      config-sh) write_config_sh "$records" "$target" ;;
    esac
  fi

  if [ "$OPT_RESET_LAYOUT" -eq 1 ]; then
    reset_layout_file "$RESOLVED_FORMAT"
  else
    write_layout "$records" "$RESOLVED_FORMAT"
  fi

  write_state "$slug"
  manifest_write "$(basename "$target")"

  reloaded=""
  if [ "$OPT_NO_RELOAD" -eq 0 ]; then
    if command -v sketchybar >/dev/null 2>&1; then
      if sketchybar --reload >/dev/null 2>&1; then
        reloaded=" (reloaded)"
      else
        err "warning: \`sketchybar --reload\` failed; the theme was still written"
      fi
    else
      err "warning: sketchybar is not on PATH; skipped reload"
    fi
  fi

  info "Applied $name ($slug) -> $target$reloaded"
  if [ "$RESOLVED_FORMAT" = "config-sh" ]; then
    info ""
    info "Source it from your config.sh:"
    info "  source \"\$CONFIG_DIR/${target#"$RESOLVED_DIR"/}\""
  fi
  if note_text=$(theme_note "$slug"); then
    info "  note: $note_text"
  fi
}

cmd_current() {
  local slug file
  if ! slug=$(read_state) || [ -z "$slug" ]; then
    info "none"
    return 1
  fi
  if [ "$OPT_VERBOSE" -eq 1 ]; then
    if file=$(find_palette "$slug" 2>/dev/null); then
      printf '%s\t%s\n' "$slug" "$file"
    else
      printf '%s\t(palette file not found)\n' "$slug"
    fi
  else
    printf '%s\n' "$slug"
  fi
}

cmd_preview() {
  local slug="$1" file records use_color=0 name variant

  file=$(find_palette "$slug") || die "$EX_NOTFOUND" "theme not found: $slug"
  records=$(stm_parse_palette "$file")
  records=$(apply_mapping "$records")
  records=$(apply_alpha "$records")

  if [ "$OPT_PORCELAIN" -eq 1 ]; then
    stm_records_colors "$records"
    return 0
  fi

  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; then
    use_color=1
  fi

  name=$(stm_records_meta "$records" name)
  variant=$(stm_records_meta "$records" variant_label)
  printf '%s (%s)\n' "$name" "$slug"
  [ "$variant" != "$name" ] && printf 'variant: %s\n' "$variant"
  printf '\n'

  stm_records_colors "$records" | while IFS=$'\t' read -r k v; do
    if [ "$use_color" -eq 1 ]; then
      local rgb r g b
      rgb=${v#0x}
      rgb=${rgb#??} # drop the alpha byte
      r=$((16#${rgb:0:2}))
      g=$((16#${rgb:2:2}))
      b=$((16#${rgb:4:2}))
      printf '  %-14s %s  \033[48;2;%d;%d;%dm    \033[0m\n' "$k" "$v" "$r" "$g" "$b"
    else
      printf '  %-14s %s\n' "$k" "$v"
    fi
  done

  if stm_records_has_layout "$records"; then
    printf '\nLayout\n'
    stm_records_layout "$records" | while IFS=$'\t' read -r k v; do
      [ -n "$k" ] || continue
      printf '  %-14s %s\n' "$k" "$v"
    done
    if stm_records_items "$records" | grep -q .; then
      printf '\nItems\n'
      stm_records_items "$records" | while IFS=$'\t' read -r k v; do
        [ -n "$k" ] || continue
        printf '  %-14s %s\n' "$k" "$v"
      done
    fi
  fi
}

# cmd_lint <file-or-slug> — fail-closed verdict; writes nothing to the user bar.
cmd_lint() {
  local spec="$1" file=""

  [ -n "$spec" ] || die "$EX_USAGE" "lint needs a palette file or theme name"

  # Existing file, a path, or a .toml name → file. Otherwise a slug.
  case "$spec" in
    */* | *.toml)
      [ -f "$spec" ] || die "$EX_NOTFOUND" "palette file not found: $spec"
      file="$spec"
      ;;
    *)
      if [ -f "$spec" ]; then
        file="$spec"
      else
        validate_slug "$spec"
        file=$(find_palette "$spec") || die "$EX_NOTFOUND" "theme not found: $spec"
      fi
      ;;
  esac

  stm_lint_file "$file"

  if [ "$OPT_PORCELAIN" -eq 1 ]; then
    printf 'ok\t%s\n' "$STM_LINT_SLUG"
  else
    info "ok $STM_LINT_SLUG"
  fi
}

cmd_init() {
  local dest="./palettes" cfg="./stm.config.toml" bundled f slug copied=0 fmt

  if [ -n "$OPT_FORMAT" ]; then
    fmt="$OPT_FORMAT"
  elif [ -d "$RESOLVED_DIR" ] && fmt=$(detect_format "$RESOLVED_DIR" 2>/dev/null); then
    :
  else
    fmt="auto"
  fi

  mkdir -p "$dest"

  if bundled=$(bundled_palette_dir); then
    for f in "$bundled"/*.toml; do
      [ -f "$f" ] || continue
      slug=$(basename "$f")
      if [ -e "$dest/$slug" ]; then
        note "kept existing $dest/$slug"
        continue
      fi
      cp "$f" "$dest/$slug"
      copied=$((copied + 1))
    done
  else
    err "warning: could not locate the bundled palettes; created an empty $dest"
  fi

  if [ -e "$cfg" ]; then
    info "kept existing $cfg"
  else
    cat >"$cfg" <<EOF
# stm — SketchyBar Theme Manager
# https://github.com/noomz/sketchybar-theme-manager

sketchybar_dir = "$RESOLVED_DIR"
format = "$fmt"
palette_dir = "$(pwd)/palettes"
default_theme = "tokyo-night"
EOF
    info "wrote $cfg"
  fi

  info "palettes: $dest ($copied new)"

  if [ "$fmt" = "lua" ] || [ "$fmt" = "auto" ]; then
    cat <<'EOF'

Wire the generated palette into your Lua config by making colors.lua fall back
to it. stm writes colors_generated.lua and never touches colors.lua, so your
own values stay in place as the default:

    local defaults = {
      black = 0xff1a1b26,
      -- ... your existing colours ...
    }

    local ok, generated = pcall(require, "colors_generated")
    if ok and type(generated) == "table" then
      for k, v in pairs(generated) do
        defaults[k] = v
      end
    end

    return defaults

Optional: if a palette carries [layout] / [items], stm also writes
layout_generated.lua. Wire it the same way — your item scripts stay yours:

    local layout = {}
    local ok_l, generated_l = pcall(require, "layout_generated")
    if ok_l and type(generated_l) == "table" then
      layout = generated_l
    end

    local function pos(name, default)
      if layout.position_of and layout.position_of[name] then
        return layout.position_of[name]
      end
      return default
    end
EOF
  fi
}

# config_used_keys <dir> <format> — emit, one per line, the canonical palette
# key names the user's own config actually consumes.
#
# Lua: every `colors.X` / `colors.bar.X` reference in their .lua files, with the
# sub-table forms folded back to the flat canonical name. Non-colour members
# (with_alpha, display) are excluded — they are structure, not palette data.
# Bash: every NAME assigned a 0x literal in colors.sh.
# shellcheck disable=SC2018,SC2019  # shell var names are ASCII and LC_ALL=C is set
config_used_keys() {
  local dir="$1" fmt="$2"
  if [ "$fmt" = "lua" ]; then
    # Comments are stripped first: prose mentioning "colors.lua" would otherwise
    # be read as a reference to a colour key named `lua`.
    find "$dir" -type f -name '*.lua' -exec awk '{ sub(/--.*$/, ""); print }' {} + 2>/dev/null |
      grep -oE 'colors\.[a-zA-Z_][a-zA-Z0-9_.]*' |
      sed 's/^colors\.//' |
      sed 's/^bar\./bar_/; s/^popup\./popup_/' |
      sed 's/\..*$//' |
      grep -vxE 'with_alpha|display' |
      grep -xE '[a-z][a-z0-9_]*' |
      sort -u
  else
    grep -hoE '^[[:space:]]*(export[[:space:]]+)?[A-Z][A-Z0-9_]*=0x' "$dir/colors.sh" 2>/dev/null |
      sed 's/^[[:space:]]*//; s/^export[[:space:]]*//; s/=0x$//' |
      tr 'A-Z' 'a-z' |
      sort -u
  fi
}

cmd_doctor() {
  local slug file records provided used tmpdir rc=0 n_missing=0 n_unused=0 fmt
  local mk mv

  tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/.stm-list.XXXXXX") ||
    die "$EX_CONFIG" "could not create a temporary directory"
  STM_TMPDIRS="$STM_TMPDIRS
$tmpdir"
  provided="$tmpdir/provided"
  used="$tmpdir/used"

  printf '%s %s\n\n' "$PROGNAME" "$STM_VERSION"

  printf 'Environment\n'
  if command -v sketchybar >/dev/null 2>&1; then
    printf '  %-16s %s\n' "sketchybar" "$(command -v sketchybar)"
  else
    printf '  %-16s %s\n' "sketchybar" "NOT FOUND on PATH"
    rc=1
  fi
  printf '  %-16s %s\n' "config dir" "$RESOLVED_DIR"
  if [ ! -d "$RESOLVED_DIR" ]; then
    printf '  %-16s %s\n' "" "does not exist"
    printf '\nFAIL\n'
    return 2
  fi

  if fmt=$(detect_format "$RESOLVED_DIR" 2>/dev/null); then
    printf '  %-16s %s\n' "format" "$fmt (detected)"
  else
    if [ -n "$OPT_FORMAT" ]; then
      fmt="$OPT_FORMAT"
      printf '  %-16s %s\n' "format" "$fmt (forced)"
    else
      printf '  %-16s %s\n' "format" "COULD NOT DETECT (pass --format)"
      printf '\nFAIL\n'
      return 2
    fi
  fi
  RESOLVED_FORMAT="$fmt"

  if [ "$fmt" = "lua" ]; then
    resolve_lua_dialect
    printf '  %-16s %s\n' "lua dialect" "$RESOLVED_LUA_DIALECT"
  fi

  printf '  %-16s %s\n' "palette dirs" "$(palette_dirs | tr '\n' ' ')"
  if [ -f "$(layout_path "$fmt" 2>/dev/null)" ]; then
    printf '  %-16s %s\n' "layout overlay" "$(layout_path "$fmt")"
  else
    printf '  %-16s %s\n' "layout overlay" "none"
  fi

  slug=$(read_state 2>/dev/null || true)
  if [ -n "${1:-}" ]; then
    slug="$1"
    printf '  %-16s %s (requested)\n' "theme" "$slug"
  elif [ -n "$slug" ]; then
    printf '  %-16s %s (active)\n' "theme" "$slug"
  else
    printf '  %-16s %s\n' "theme" "none applied yet; checking default"
    slug="tokyo-night"
  fi

  if ! file=$(find_palette "$slug"); then
    printf '\n  palette not found: %s\n' "$slug"
    printf '\nFAIL\n'
    return 3
  fi

  records=$(stm_parse_palette "$file")
  STM_MAPPING_STRICT=0
  records=$(apply_mapping "$records")
  records=$(apply_alpha "$records")
  STM_MAPPING_STRICT=1
  stm_records_colors "$records" | cut -f1 | sort -u >"$provided"
  config_used_keys "$RESOLVED_DIR" "$fmt" >"$used"

  # [mapping] entries: every right-hand side must resolve, or apply will fail.
  if [ -n "$RESOLVED_CONFIG" ] && stm_config_pairs "$RESOLVED_CONFIG" mapping | grep -q .; then
    printf '\nMapping\n'
    while IFS=$'\t' read -r mk mv; do
      [ -n "$mk" ] || continue
      case "$mv" in
        "0x"* | "#"*) printf '  %-24s -> %s (literal)\n' "$mk" "$mv" ;;
        *)
          if printf '%s\n' "$records" |
            awk -F'\t' -v k="$mv" '($1=="color" || $1=="extra") && $2==k' | grep -q .; then
            printf '  %-24s -> %s\n' "$mk" "$mv"
          else
            printf '  %-24s -> %s  UNRESOLVED\n' "$mk" "$mv"
            rc=1
          fi
          ;;
      esac
    done <<EOF
$(stm_config_pairs "$RESOLVED_CONFIG" mapping)
EOF
  fi

  # Templates: report which one would be used, and that it actually renders.
  local tdir tfile
  tdir=$(template_dir)
  if [ -d "$tdir" ]; then
    printf '\nTemplates (%s)\n' "$tdir"
    for tfile in "$tdir"/*.tpl; do
      [ -f "$tfile" ] || continue
      if render_template_check "$records" "$tfile"; then
        printf '  %-24s ok\n' "$(basename "$tfile")"
      else
        printf '  %-24s INVALID\n' "$(basename "$tfile")"
        rc=1
      fi
    done
  fi

  printf '\nKey coverage (config vs palette "%s")\n' "$slug"

  if [ ! -s "$used" ]; then
    printf '  %s\n' "could not find any colour references in $RESOLVED_DIR"
  else
    n_missing=$(comm -23 "$used" "$provided" | wc -l | tr -d ' ')
    n_unused=$(comm -13 "$used" "$provided" | wc -l | tr -d ' ')

    printf '  %-24s %s\n' "used and provided" \
      "$(comm -12 "$used" "$provided" | tr '\n' ' ')"

    # A key the config uses but the palette lacks means different things per
    # format. In Lua it resolves to nil and the config breaks at load, so it is
    # an error. In Bash the variable simply keeps whatever literal it already
    # had — stm just does not manage it — so it is informational.
    if [ "$n_missing" -gt 0 ]; then
      if [ "$fmt" = "lua" ]; then
        printf '  %-24s %s\n' "USED BUT MISSING" "$(comm -23 "$used" "$provided" | tr '\n' ' ')"
        printf '  %-24s %s\n' "" "these resolve to nil in Lua and will break the bar"
        rc=1
      else
        printf '  %-24s %s\n' "not managed by stm" "$(comm -23 "$used" "$provided" | tr '\n' ' ')"
        printf '  %-24s %s\n' "" "these keep their current values; add them to the palette to theme them"
      fi
    else
      printf '  %-24s %s\n' "used but missing" "(none)"
    fi

    if [ "$n_unused" -gt 0 ]; then
      printf '  %-24s %s\n' "provided but unused" "$(comm -13 "$used" "$provided" | tr '\n' ' ')"
    fi
  fi

  printf '\n'
  if [ "$rc" -eq 0 ]; then
    printf 'OK\n'
  else
    printf 'PROBLEMS FOUND\n'
  fi
  return "$rc"
}

# ---------------------------------------------------------------------------
# Manifest and verify
#
# The non-destructiveness promise is that stm touches only the files it owns.
# A manifest makes that promise checkable rather than merely stated: after an
# apply, every other regular file in the config dir is checksummed, and
# `stm verify` reports anything that has since changed, appeared, or vanished.
# ---------------------------------------------------------------------------

manifest_path() { printf '%s\n' "$RESOLVED_DIR/.stm-manifest"; }

# manifest_lines <dir> <managed-basename> — `sha  ./relpath` for every regular
# file stm does not own. `find -type f` is false for symlinks, so a link
# pointing outside the config dir is never followed or recorded.
manifest_lines() {
  local dir="$1" managed="$2"
  (
    cd "$dir" 2>/dev/null || exit 0
    find . -type f \
      ! -path './.git/*' \
      ! -path './.stm-backups/*' \
      ! -name '.stm-manifest' \
      ! -name '.stm-state' \
      ! -name '*.stm-backup' \
      ! -name '*.stm-bak-*' \
      ! -name '.stm-tmp.*' \
      ! -name 'layout_generated.lua' \
      ! -name 'layout.sh' \
      ! -name "$managed" \
      -exec shasum -a 256 {} + 2>/dev/null
  ) | sort -k2
}

manifest_write() {
  local managed="$1" tmp
  [ "$OPT_NO_MANIFEST" -eq 0 ] || return 0
  command -v shasum >/dev/null 2>&1 || {
    note "shasum not found; skipping the manifest"
    return 0
  }
  mktemp_in "$RESOLVED_DIR"
  tmp="$STM_TMP"
  manifest_lines "$RESOLVED_DIR" "$managed" >"$tmp"
  commit_tmp "$tmp" "$(manifest_path)"
  note "manifest written: $(manifest_path)"
}

cmd_verify() {
  local mf managed fmt now tmpdir rc=0 n_changed n_added n_removed

  [ -d "$RESOLVED_DIR" ] || die "$EX_CONFIG" "sketchybar config dir does not exist: $RESOLVED_DIR"
  mf=$(manifest_path)
  if [ ! -f "$mf" ]; then
    err "no manifest at $mf — run \`stm apply\` once to record a baseline"
    return 2
  fi
  command -v shasum >/dev/null 2>&1 || die "$EX_CONFIG" "shasum is required for verify"

  if fmt=$(detect_format "$RESOLVED_DIR" 2>/dev/null); then :; else fmt="${OPT_FORMAT:-lua}"; fi
  RESOLVED_FORMAT="$fmt"
  managed=$(basename "$(target_path "$fmt")")

  tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/.stm-list.XXXXXX") ||
    die "$EX_CONFIG" "could not create a temporary directory"
  STM_TMPDIRS="$STM_TMPDIRS
$tmpdir"
  now="$tmpdir/now"
  manifest_lines "$RESOLVED_DIR" "$managed" >"$now"

  # Compare by path, then by checksum.
  awk '{ print $2 }' "$mf" | sort >"$tmpdir/old_paths"
  awk '{ print $2 }' "$now" | sort >"$tmpdir/new_paths"

  n_removed=$(comm -23 "$tmpdir/old_paths" "$tmpdir/new_paths" | wc -l | tr -d ' ')
  n_added=$(comm -13 "$tmpdir/old_paths" "$tmpdir/new_paths" | wc -l | tr -d ' ')
  n_changed=$(awk 'NR==FNR { h[$2] = $1; next } ($2 in h) && h[$2] != $1 { print $2 }' \
    "$mf" "$now" | wc -l | tr -d ' ')

  info "Verifying $RESOLVED_DIR against $(basename "$mf")"
  info "  managed by stm (not checked): $managed layout_generated.lua layout.sh .stm-backups/"
  info ""

  if [ "$n_changed" -gt 0 ]; then
    info "CHANGED since the last apply:"
    awk 'NR==FNR { h[$2] = $1; next } ($2 in h) && h[$2] != $1 { printf("  %s\n", $2) }' \
      "$mf" "$now"
    rc=1
  fi
  if [ "$n_added" -gt 0 ]; then
    info "ADDED since the last apply:"
    comm -13 "$tmpdir/old_paths" "$tmpdir/new_paths" | sed 's/^/  /'
    rc=1
  fi
  if [ "$n_removed" -gt 0 ]; then
    info "REMOVED since the last apply:"
    comm -23 "$tmpdir/old_paths" "$tmpdir/new_paths" | sed 's/^/  /'
    rc=1
  fi

  if [ "$rc" -eq 0 ]; then
    info "OK — $(wc -l <"$now" | tr -d ' ') files unchanged; stm touched only what it owns"
  else
    info ""
    info "stm does not write these files. Something else changed them, which is"
    info "usually you editing your config — re-run \`stm apply\` to re-baseline."
  fi
  return "$rc"
}

# ---------------------------------------------------------------------------
# backup / restore
#
# Default scope is stm-owned files (generated overlays + .stm-state).
# `backup --all` copies the whole config dir so a working bar can be frozen
# before the first apply. Restore follows the snapshot's recorded scope.
# ---------------------------------------------------------------------------

backups_dir() { printf '%s\n' "$RESOLVED_DIR/.stm-backups"; }

validate_backup_name() {
  local s="$1"
  case "$s" in
    "" | "." | "..") die "$EX_USAGE" "invalid backup name: \"$s\"" ;;
    */*) die "$EX_USAGE" "invalid backup name (may not contain \"/\"): \"$s\"" ;;
    .*) die "$EX_USAGE" "invalid backup name (may not start with a dot): \"$s\"" ;;
  esac
  if [ "${#s}" -gt 64 ]; then
    die "$EX_USAGE" "backup name is too long (max 64): \"$s\""
  fi
  case "$s" in
    *[!A-Za-z0-9._-]*) die "$EX_USAGE" "invalid backup name \"$s\" (allowed: A-Z a-z 0-9 . _ -)" ;;
  esac
  case "$s" in
    [A-Za-z0-9]*) : ;;
    *) die "$EX_USAGE" "backup name must start with a letter or digit: \"$s\"" ;;
  esac
}

is_auto_backup_name() {
  case "$1" in
    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z) return 0 ;;
    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z-[0-9]*) return 0 ;;
  esac
  return 1
}

backup_meta_get() {
  local file="$1/manifest.toml" key="$2"
  [ -f "$file" ] || return 1
  awk -F' = ' -v k="$key" '
    $1 == k {
      v = $2
      sub(/^[ \t]*"/, "", v)
      sub(/"[ \t]*$/, "", v)
      print v
      exit
    }
  ' "$file"
}

write_backup_manifest() {
  local dest="$1" scope="$2" slug fmt created
  slug=$(read_state 2>/dev/null || true)
  fmt="${RESOLVED_FORMAT:-}"
  if [ -z "$fmt" ] && [ -d "$RESOLVED_DIR" ]; then
    fmt=$(detect_format "$RESOLVED_DIR" 2>/dev/null || true)
  fi
  created=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  {
    printf 'scope = "%s"\n' "$scope"
    printf 'slug = "%s"\n' "${slug:-none}"
    printf 'format = "%s"\n' "${fmt:-unknown}"
    printf 'created = "%s"\n' "$created"
  } >"$dest/manifest.toml"
}

# Relative paths of stm-owned files that currently exist.
owned_relpaths() {
  local f rel
  [ -d "$RESOLVED_DIR" ] || return 0
  if [ -z "$RESOLVED_FORMAT" ] && [ -d "$RESOLVED_DIR" ]; then
    RESOLVED_FORMAT=$(detect_format "$RESOLVED_DIR" 2>/dev/null || true)
  fi
  for f in \
    "$(state_file)" \
    "${RESOLVED_FORMAT:+$(target_path "$RESOLVED_FORMAT")}" \
    "${RESOLVED_FORMAT:+$(layout_path "$RESOLVED_FORMAT")}" \
    "$RESOLVED_DIR/colors_generated.lua" \
    "$RESOLVED_DIR/layout_generated.lua" \
    "$RESOLVED_DIR/layout.sh" \
    "$RESOLVED_DIR/colors.sh"; do
    [ -n "$f" ] || continue
    [ -f "$f" ] || continue
    rel="${f#"$RESOLVED_DIR"/}"
    case "$rel" in
      "" | "$f") continue ;;
      *..*) continue ;;
    esac
    printf '%s\n' "$rel"
  done | sort -u
}

snapshot_owned() {
  local name="$1" dest f rel n=0
  dest="$(backups_dir)/$name"
  mkdir -p "$dest"
  : >"$dest/files.list"
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    f="$RESOLVED_DIR/$rel"
    [ -f "$f" ] || continue
    mkdir -p "$dest/$(dirname "$rel")"
    cp -p "$f" "$dest/$rel"
    printf '%s\n' "$rel" >>"$dest/files.list"
    n=$((n + 1))
  done <<EOF
$(owned_relpaths)
EOF
  write_backup_manifest "$dest" "owned"
  printf '%s\n' "$n"
}

# True if $2 is inside directory $1. Both sides are resolved to absolute
# paths so a relative config dir still matches a fully resolved symlink.
path_inside() {
  local root="$1" p="$2" root_abs
  if [ -d "$root" ]; then
    root_abs=$(cd -- "$root" && pwd) || root_abs="$root"
  else
    root_abs="$root"
  fi
  case "$p" in
    "$root_abs" | "$root_abs"/* | "$root" | "$root"/*) return 0 ;;
    *) return 1 ;;
  esac
}

snapshot_all() {
  local name="$1" dest src rel real n=0
  dest="$(backups_dir)/$name"
  src="$RESOLVED_DIR"
  mkdir -p "$dest/tree"
  : >"$dest/files.list"
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    rel="${rel#./}"
    [ -n "$rel" ] || continue
    case "$rel" in
      .stm-backups | .stm-backups/* | .git | .git/*) continue ;;
    esac
    if [ -L "$src/$rel" ]; then
      real=$(resolve_symlinks "$src/$rel")
      if path_inside "$src" "$real"; then
        mkdir -p "$dest/tree/$(dirname "$rel")"
        rm -f "$dest/tree/$rel"
        ln -s "$(readlink "$src/$rel")" "$dest/tree/$rel"
        printf '%s\n' "$rel" >>"$dest/files.list"
        n=$((n + 1))
      else
        err "warning: skipping symlink that escapes the config dir: $rel"
      fi
    elif [ -f "$src/$rel" ]; then
      mkdir -p "$dest/tree/$(dirname "$rel")"
      cp -p "$src/$rel" "$dest/tree/$rel"
      printf '%s\n' "$rel" >>"$dest/files.list"
      n=$((n + 1))
    fi
  done <<EOF
$(
    cd "$src" 2>/dev/null || exit 0
    find . \( -path './.stm-backups' -o -path './.stm-backups/*' \
      -o -path './.git' -o -path './.git/*' \) -prune -o \
      \( -type f -o -type l \) -print
  )
EOF
  write_backup_manifest "$dest" "all"
  printf '%s\n' "$n"
}

prune_auto_backups() {
  local dir names n drop
  dir=$(backups_dir)
  [ -d "$dir" ] || return 0
  names=""
  for d in "$dir"/*; do
    [ -d "$d" ] || continue
    if is_auto_backup_name "$(basename "$d")"; then
      names="$names$(basename "$d")
"
    fi
  done
  [ -n "$names" ] || return 0
  names=$(printf '%s' "$names" | sort)
  n=$(printf '%s\n' "$names" | grep -c . | tr -d ' ')
  [ -n "$n" ] || return 0
  if [ "$n" -gt 5 ]; then
    drop=$((n - 5))
    printf '%s\n' "$names" | head -n "$drop" | while IFS= read -r old; do
      [ -n "$old" ] || continue
      [ -n "$dir" ] || continue
      case "$old" in
        "" | . | .. | /*) continue ;;
      esac
      rm -rf "${dir:?}/$old"
      note "pruned auto backup: $old"
    done
  fi
}

auto_backup_owned() {
  local name n dest
  [ "$OPT_NO_BACKUP" -eq 1 ] && return 0
  [ "$OPT_DRY_RUN" -eq 1 ] && return 0
  [ -d "$RESOLVED_DIR" ] || return 0
  name=$(date -u +%Y%m%dT%H%M%SZ)
  dest="$(backups_dir)/$name"
  n=1
  while [ -e "$dest" ] && [ "$n" -lt 100 ]; do
    dest="$(backups_dir)/${name}-$n"
    n=$((n + 1))
  done
  name=$(basename "$dest")
  snapshot_owned "$name" >/dev/null
  prune_auto_backups
  note "auto backup: $name"
}

latest_auto_backup() {
  local dir d latest=""
  dir=$(backups_dir)
  [ -d "$dir" ] || return 1
  for d in "$dir"/*; do
    [ -d "$d" ] || continue
    is_auto_backup_name "$(basename "$d")" || continue
    latest=$(basename "$d")
  done
  [ -n "$latest" ] || return 1
  printf '%s\n' "$latest"
}

restore_owned() {
  local snap="$1" rel f
  [ -f "$snap/files.list" ] || die "$EX_INVALID" "snapshot is missing files.list: $snap"
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    case "$rel" in
      "" | *..* | /* | .stm-backups | .stm-backups/*) continue ;;
    esac
    f="$snap/$rel"
    [ -f "$f" ] || continue
    mkdir -p "$RESOLVED_DIR/$(dirname "$rel")"
    assert_writable_target "$RESOLVED_DIR/$rel"
    cp -p "$f" "$RESOLVED_DIR/$rel"
  done <"$snap/files.list"

  # Exact set: drop currently-owned files the snapshot did not list.
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    if ! grep -qxF -- "$rel" "$snap/files.list" 2>/dev/null; then
      rm -f "$RESOLVED_DIR/$rel"
      note "removed $rel (not in snapshot)"
    fi
  done <<EOF
$(owned_relpaths)
EOF
}

restore_all() {
  local snap="$1" tree rel real
  tree="$snap/tree"
  [ -d "$tree" ] || die "$EX_INVALID" "snapshot has no tree/ (not an --all backup): $snap"

  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    rel="${rel#./}"
    case "$rel" in
      "" | *..* | /* | .stm-backups | .stm-backups/* | .git | .git/*) continue ;;
    esac
    mkdir -p "$RESOLVED_DIR/$(dirname "$rel")"
    if [ -L "$tree/$rel" ]; then
      real=$(resolve_symlinks "$tree/$rel")
      path_inside "$tree" "$real" || continue
      rm -f "$RESOLVED_DIR/$rel"
      ln -s "$(readlink "$tree/$rel")" "$RESOLVED_DIR/$rel"
    elif [ -f "$tree/$rel" ]; then
      assert_writable_target "$RESOLVED_DIR/$rel"
      cp -p "$tree/$rel" "$RESOLVED_DIR/$rel"
    fi
  done <<EOF
$(
    cd "$tree" 2>/dev/null || exit 0
    find . \( -type f -o -type l \) -print
  )
EOF

  # Remove live files that the snapshot does not have (except the catalogue).
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    rel="${rel#./}"
    case "$rel" in
      "" | .stm-backups | .stm-backups/* | .git | .git/*) continue ;;
    esac
    if [ ! -e "$tree/$rel" ] && [ ! -L "$tree/$rel" ]; then
      rm -f "$RESOLVED_DIR/$rel"
      note "removed $rel (not in snapshot)"
    fi
  done <<EOF
$(
    cd "$RESOLVED_DIR" 2>/dev/null || exit 0
    find . \( -path './.stm-backups' -o -path './.stm-backups/*' \
      -o -path './.git' -o -path './.git/*' \) -prune -o \
      \( -type f -o -type l \) -print
  )
EOF
}

maybe_reload() {
  if [ "$OPT_NO_RELOAD" -eq 0 ]; then
    if command -v sketchybar >/dev/null 2>&1; then
      if sketchybar --reload >/dev/null 2>&1; then
        return 0
      fi
      err "warning: \`sketchybar --reload\` failed; the files were still written"
    else
      err "warning: sketchybar is not on PATH; skipped reload"
    fi
  fi
}

fresh_backup_name() {
  local name="$1" dest n=1
  dest="$(backups_dir)/$name"
  while [ -e "$dest" ] && [ "$n" -lt 100 ]; do
    dest="$(backups_dir)/${name}-$n"
    n=$((n + 1))
  done
  basename "$dest"
}

cmd_backup() {
  local name="${1:-}" dest n scope="owned"

  [ -d "$RESOLVED_DIR" ] || die "$EX_CONFIG" "sketchybar config dir does not exist: $RESOLVED_DIR"

  if [ -n "$name" ]; then
    validate_backup_name "$name"
    dest="$(backups_dir)/$name"
    if [ -e "$dest" ] && [ "$OPT_FORCE" -eq 0 ]; then
      die "$EX_EXISTS" "backup \"$name\" already exists (pass --force to replace)"
    fi
    [ -e "$dest" ] && rm -rf "$dest"
  else
    name=$(fresh_backup_name "$(date -u +%Y%m%dT%H%M%SZ)")
  fi

  if [ "$OPT_DRY_RUN" -eq 1 ]; then
    if [ "$OPT_ALL" -eq 1 ]; then
      info "would backup --all $RESOLVED_DIR -> .stm-backups/$name"
    else
      info "would backup owned files -> .stm-backups/$name"
      owned_relpaths | sed 's/^/  /'
    fi
    return 0
  fi

  if [ "$OPT_ALL" -eq 1 ]; then
    scope="all"
    n=$(snapshot_all "$name")
  else
    n=$(snapshot_owned "$name")
  fi

  info "Backed up $n file(s) ($scope) -> $(backups_dir)/$name"
}

cmd_restore() {
  local name="${1:-}" snap scope n

  [ -d "$RESOLVED_DIR" ] || die "$EX_CONFIG" "sketchybar config dir does not exist: $RESOLVED_DIR"

  if [ -z "$name" ]; then
    name=$(latest_auto_backup) || die "$EX_NOTFOUND" "no auto backup to restore (pass a name or run apply once)"
  else
    validate_backup_name "$name"
  fi

  snap="$(backups_dir)/$name"
  [ -d "$snap" ] || die "$EX_NOTFOUND" "backup not found: $name"
  scope=$(backup_meta_get "$snap" scope || true)
  [ -n "$scope" ] || scope="owned"

  if [ "$OPT_DRY_RUN" -eq 1 ]; then
    info "would restore $name (scope=$scope) into $RESOLVED_DIR"
    if [ "$scope" = "all" ] && [ -d "$snap/tree" ]; then
      (cd "$snap/tree" && find . \( -type f -o -type l \) -print | sed 's|^\./||; s/^/  /')
    elif [ -f "$snap/files.list" ]; then
      sed 's/^/  /' "$snap/files.list"
    fi
    return 0
  fi

  if [ "$scope" = "all" ]; then
    n=$(find "$snap/tree" \( -type f -o -type l \) 2>/dev/null | wc -l | tr -d ' ')
    info "this will replace $n file(s) in $RESOLVED_DIR"
    restore_all "$snap"
  else
    restore_owned "$snap"
  fi

  maybe_reload
  info "Restored $name ($scope) -> $RESOLVED_DIR"
}

cmd_backups() {
  local dir d name created scope slug
  dir=$(backups_dir)
  if [ ! -d "$dir" ]; then
    [ "$OPT_PORCELAIN" -eq 1 ] || info "no backups"
    return 0
  fi
  for d in "$dir"/*; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    created=$(backup_meta_get "$d" created || true)
    scope=$(backup_meta_get "$d" scope || true)
    slug=$(backup_meta_get "$d" slug || true)
    if [ "$OPT_PORCELAIN" -eq 1 ]; then
      printf '%s\t%s\t%s\t%s\n' "$name" "${created:-}" "${scope:-}" "${slug:-}"
    else
      printf '%-24s  %s  %s  %s\n' "$name" "${created:-}" "${scope:-owned}" "${slug:-}"
    fi
  done
}

# ---------------------------------------------------------------------------
# import / export
# ---------------------------------------------------------------------------

# Extract `key<TAB>0xAARRGGBB` pairs from an existing Lua colours module. One
# level of nesting is folded to the flat canonical name (bar.bg -> bar_bg).
# Functions and any non-hex value are skipped and counted.
#
# shellcheck disable=SC2016  # awk source
STM_IMPORT_LUA_AWK='
BEGIN { tbl = "" }
{
  line = $0
  sub(/\r$/, "", line)
  sub(/--.*$/, "", line)

  if (line ~ /^[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*=[ \t]*\{[ \t]*$/) {
    tbl = line
    sub(/^[ \t]*/, "", tbl)
    sub(/[ \t]*=.*$/, "", tbl)
    next
  }
  if (line ~ /^[ \t]*\}/) { tbl = ""; next }

  if (line !~ /^[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*=/) next

  k = line
  sub(/^[ \t]*/, "", k)
  sub(/[ \t]*=.*$/, "", k)

  v = line
  sub(/^[^=]*=[ \t]*/, "", v)
  sub(/[ \t]*,?[ \t]*$/, "", v)

  if (v !~ /^0[xX][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/) {
    printf("skip\t%s\t%s\n", (tbl == "" ? k : tbl "_" k), v) > "/dev/stderr"
    next
  }
  full = (tbl == "" ? k : tbl "_" k)
  if (full !~ /^[a-z][a-z0-9_]*$/) {
    printf("skip\t%s\t%s\n", full, v) > "/dev/stderr"
    next
  }
  printf("%s\t%s\n", full, tolower(v))
}
'

# Extract pairs from an existing colors.sh. `export A=$B` reference lines are
# resolved one level so the imported palette carries real values.
#
# shellcheck disable=SC2016  # awk source
STM_IMPORT_BASH_AWK='
{
  line = $0
  sub(/\r$/, "", line)
  sub(/[ \t]*#.*$/, "", line)
  sub(/^[ \t]*/, "", line)
  sub(/^export[ \t]+/, "", line)

  if (line !~ /^[A-Za-z_][A-Za-z0-9_]*=/) next

  k = line
  sub(/=.*$/, "", k)
  v = line
  sub(/^[^=]*=/, "", v)
  gsub(/^["'"'"']|["'"'"']$/, "", v)

  if (v ~ /^\$/) {
    ref = v
    sub(/^\$\{?/, "", ref)
    sub(/\}$/, "", ref)
    if (ref in seen) v = seen[ref]
    else { printf("skip\t%s\t%s\n", tolower(k), v) > "/dev/stderr"; next }
  }

  if (v !~ /^0[xX][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/) {
    printf("skip\t%s\t%s\n", tolower(k), v) > "/dev/stderr"
    next
  }
  seen[k] = v
  lk = tolower(k)
  if (lk !~ /^[a-z][a-z0-9_]*$/) {
    printf("skip\t%s\t%s\n", lk, v) > "/dev/stderr"
    next
  }
  printf("%s\t%s\n", lk, tolower(v))
}
'

cmd_export() {
  local slug="$1" file records out name variant k v

  file=$(find_palette "$slug") || die "$EX_NOTFOUND" "theme not found: $slug"
  records=$(stm_parse_palette "$file")
  name=$(stm_records_meta "$records" name)
  variant=$(stm_records_meta "$records" variant_label)

  out=$(
    printf '# Exported by stm %s\n' "$STM_VERSION"
    printf 'name = "%s"\n' "$name"
    printf 'slug = "%s"\n' "$slug"
    printf 'variant_label = "%s"\n' "$variant"
    printf '\n[colors]\n'
    printf '%s\n' "$records" |
      awk -F'\t' '$1=="color" { printf("%s\t%s\n", $2, $3) }' | sort |
      while IFS=$'\t' read -r k v; do printf '%s = "%s"\n' "$k" "$v"; done
    if stm_records_extras "$records" | grep -q .; then
      printf '\n[extras]\n'
      stm_records_extras "$records" |
        while IFS=$'\t' read -r k v; do printf '%s = "%s"\n' "$k" "$v"; done
    fi
    if stm_records_layout "$records" | grep -q .; then
      printf '\n[layout]\n'
      stm_records_layout "$records" |
        while IFS=$'\t' read -r k v; do printf '%s = "%s"\n' "$k" "$v"; done
    fi
    if stm_records_items "$records" | grep -q .; then
      printf '\n[items]\n'
      stm_records_items "$records" |
        while IFS=$'\t' read -r k v; do printf '%s = "%s"\n' "$k" "$v"; done
    fi
  )

  if [ -n "$OPT_OUT" ]; then
    printf '%s\n' "$out" >"$OPT_OUT"
    info "exported $slug -> $OPT_OUT"
  else
    printf '%s\n' "$out"
  fi
}

# import_read_pairs <src> <fmt> <uniq_out> <skips_out>
# Extract key<TAB>0xAARRGGBB pairs. Later definitions win. Skipped (non-hex)
# lines go to skips_out as `skip<TAB>key<TAB>value`.
import_read_pairs() {
  local src="$1" fmt="$2" uniq_out="$3" skips_out="$4"
  local raw
  raw="${uniq_out}.raw"
  if [ "$fmt" = "lua" ]; then
    awk "$STM_IMPORT_LUA_AWK" "$src" >"$raw" 2>"$skips_out"
  else
    awk "$STM_IMPORT_BASH_AWK" "$src" >"$raw" 2>"$skips_out"
  fi
  # Later definitions win, matching how both formats actually behave.
  sort -u -k1,1 "$raw" >"$uniq_out" 2>/dev/null ||
    awk -F'\t' '{ v[$1] = $2 } END { for (k in v) printf("%s\t%s\n", k, v[k]) }' \
      "$raw" | sort >"$uniq_out"
  rm -f "$raw"
}

# import_missing_required <uniq_file> — echo missing canonical keys, or empty.
import_missing_required() {
  local uniq="$1" missing="" k
  for k in $STM_REQUIRED_KEYS; do
    if ! awk -F'\t' -v k="$k" '$1==k' "$uniq" | grep -q .; then
      missing="$missing $k"
    fi
  done
  printf '%s\n' "$missing"
}

# write_imported_palette <dest> <src_label> <slug> <base> <uniq_file>
# Atomic-enough: write the whole file in one redirection. The source path is
# echoed into a comment, so any newline in it would inject TOML; flatten it.
write_imported_palette() {
  local dest="$1" src_label="$2" slug="$3" base="$4" uniq="$5"
  src_label=$(printf '%s' "$src_label" | tr -d '\r\n')
  {
    printf '# Imported by stm %s from %s\n' "$STM_VERSION" "$src_label"
    printf 'name = "%s"\n' "$slug"
    printf 'slug = "%s"\n' "$slug"
    printf 'variant_label = "%s"\n' "$slug"
    [ -n "$base" ] && printf 'base = "%s"\n' "$base"
    printf '\n[colors]\n'
    while IFS=$'\t' read -r k v; do
      [ -n "$k" ] || continue
      printf '%s = "%s"\n' "$k" "$v"
    done <"$uniq"
  } >"$dest"
}

cmd_import() {
  local src="${1:-}" slug fmt dest dir n missing
  local blk

  if [ -n "$src" ]; then
    [ -f "$src" ] || die "$EX_NOTFOUND" "file not found: $src"
    case "$src" in
      *.lua) fmt=lua ;;
      *.sh) fmt=bash ;;
      *) die "$EX_USAGE" "cannot tell the format of $src (expected .lua or .sh)" ;;
    esac
  else
    [ -d "$RESOLVED_DIR" ] || die "$EX_CONFIG" "sketchybar config dir does not exist: $RESOLVED_DIR"
    fmt=$(detect_format "$RESOLVED_DIR")
    case "$fmt" in
      lua) src="$RESOLVED_DIR/colors.lua" ;;
      bash) src="$RESOLVED_DIR/colors.sh" ;;
    esac
    [ -f "$src" ] || die "$EX_NOTFOUND" "no colours file found in $RESOLVED_DIR"
  fi

  slug="${OPT_SLUG:-imported}"
  validate_slug "$slug"

  blk=$(mktemp -d "${TMPDIR:-/tmp}/.stm-blk.XXXXXX") ||
    die "$EX_CONFIG" "could not create a temporary directory"
  STM_TMPDIRS="$STM_TMPDIRS
$blk"

  import_read_pairs "$src" "$fmt" "$blk/uniq" "$blk/skips"

  n=$(wc -l <"$blk/uniq" | tr -d ' ')
  [ "$n" -gt 0 ] || die "$EX_INVALID" "found no colour definitions in $src"

  dir=$(user_palette_dir) ||
    die "$EX_CONFIG" "could not determine a writable palette directory; pass --palette-dir"
  mkdir -p "$dir"
  dest="$dir/$slug.toml"
  if [ -e "$dest" ] && [ "$OPT_FORCE" -eq 0 ]; then
    die "$EX_EXISTS" "$dest already exists (use --force to overwrite)"
  fi

  write_imported_palette "$dest" "$src" "$slug" "$OPT_BASE" "$blk/uniq"

  info "imported $n colours from $src -> $dest"

  missing=""
  if [ -n "$OPT_BASE" ]; then
    # With a base, the merged set is what matters, so ask the parser.
    if ! stm_parse_palette "$dest" >/dev/null 2>&1; then
      missing=" (see the error above)"
      stm_parse_palette "$dest" >/dev/null || true
    fi
  else
    missing=$(import_missing_required "$blk/uniq")
  fi

  if [ -s "$blk/skips" ]; then
    info ""
    info "Could not import these (not an 0xAARRGGBB value):"
    awk -F'\t' '{ printf("  %-24s %s\n", $2, $3) }' "$blk/skips"
  fi

  if [ -n "$missing" ]; then
    info ""
    info "Missing required key(s):$missing"
    info ""
    info "Your config names its colours differently, which is fine. The quickest"
    info "fix is to inherit the canonical keys from a bundled theme, so yours"
    info "override only what they cover:"
    info ""
    info "  stm import $src --slug $slug --base tokyo-night --force"
    info ""
    info "Or add the keys to $dest by hand. Note that [mapping] in"
    info "stm.config.toml will not help here: it is applied after a palette is"
    info "validated, so it can rename keys for your config but cannot supply"
    info "ones the palette is missing."
    rm -rf "$blk"
    return 1
  fi

  rm -rf "$blk"
  info ""
  info "Ready: stm apply $slug"
}

cmd_add() {
  local slug="$1" src="$2" records declared dest dir

  validate_slug "$slug"
  [ -f "$src" ] || die "$EX_NOTFOUND" "palette file not found: $src"

  records=$(stm_parse_palette "$src")
  declared=$(stm_records_meta "$records" slug)
  if [ "$declared" != "$slug" ]; then
    die "$EX_INVALID" "palette declares slug \"$declared\" but you asked to add it as \"$slug\""
  fi

  dir=$(user_palette_dir)
  [ -n "$dir" ] || die "$EX_CONFIG" "could not determine a writable palette directory; pass --palette-dir"
  mkdir -p "$dir"
  dest="$dir/$slug.toml"

  if [ -e "$dest" ] && [ "$OPT_FORCE" -eq 0 ]; then
    die "$EX_EXISTS" "$dest already exists (use --force to overwrite)"
  fi

  mktemp_in "$dir"
  cp "$src" "$STM_TMP"
  commit_tmp "$STM_TMP" "$dest"
  info "added $slug -> $dest"
}

# cmd_install <spec> — fetch one HTTPS .toml, lint, atomic write + ledger.
# Does not apply. Does not sketchybar --reload. add stays local-file only.
cmd_install() {
  local spec="$1" dir dest tmp work slug hash ts

  [ -n "$spec" ] || die "$EX_USAGE" "install needs owner/repo/path.toml"
  stm_parse_install_spec "$spec"

  dir=$(user_palette_dir) ||
    die "$EX_CONFIG" "could not determine a writable palette directory; pass --palette-dir"

  if [ "$OPT_DRY_RUN" -eq 1 ]; then
    work=$(mktemp -d "${TMPDIR:-/tmp}/.stm-list.XXXXXX") ||
      die "$EX_CONFIG" "could not create a temporary directory"
    STM_TMPDIRS="$STM_TMPDIRS
$work"
    tmp="$work/payload"
    stm_fetch_https "$STM_SPEC_URL" "$tmp" "$STM_SPEC_URL_FALLBACK"
    stm_lint_file "$tmp"
    dest="$dir/$STM_LINT_SLUG.toml"
    info "spec $spec"
    info "host $STM_SPEC_HOST"
    info "url $STM_SPEC_URL"
    info "dest $dest"
    info "would install $STM_LINT_SLUG -> $dest"
    rm -rf "$work"
    return 0
  fi

  mkdir -p "$dir"
  mktemp_in "$dir"
  tmp="$STM_TMP"
  stm_fetch_https "$STM_SPEC_URL" "$tmp" "$STM_SPEC_URL_FALLBACK"
  stm_lint_file "$tmp"
  slug="$STM_LINT_SLUG"
  dest="$dir/$slug.toml"

  if [ -e "$dest" ] && [ "$OPT_FORCE" -eq 0 ]; then
    die "$EX_EXISTS" "$dest already exists (use --force to overwrite)"
  fi

  hash=$(stm_sha256 "$tmp")
  ts=$(stm_iso8601)
  commit_tmp "$tmp" "$dest"
  stm_ledger_put "$slug" "$STM_SPEC_URL" "$hash" "$STM_SPEC_REF" "$ts"
  info "installed $slug -> $dest"
  note "source $STM_SPEC_URL"
  info "run: stm apply $slug"
}

# cmd_uninstall <slug> — remove a user-installed palette and its ledger row.
# Never deletes a bundled file. remove is an alias.
cmd_uninstall() {
  local slug="$1" dir dest bundled_dir bundled cur

  [ -n "$slug" ] || die "$EX_USAGE" "uninstall needs a theme name"
  validate_slug "$slug"

  dir=$(user_palette_dir) ||
    die "$EX_CONFIG" "could not determine a writable palette directory; pass --palette-dir"
  dest="$dir/$slug.toml"
  bundled_dir=$(bundled_palette_dir 2>/dev/null || true)
  bundled=""
  [ -n "$bundled_dir" ] && bundled="$bundled_dir/$slug.toml"

  if [ -L "$dest" ]; then
    die "$EX_CONFIG" "refusing to remove a symlink: $dest"
  fi
  if [ -e "$dest" ] && [ ! -f "$dest" ]; then
    die "$EX_CONFIG" "refusing to remove $dest: not a regular file"
  fi

  if [ ! -e "$dest" ]; then
    if [ -n "$bundled" ] && [ -f "$bundled" ]; then
      die "$EX_CONFIG" "refusing to uninstall bundled theme: $slug"
    fi
    die "$EX_NOTFOUND" "theme not installed: $slug"
  fi

  if [ "$OPT_DRY_RUN" -eq 1 ]; then
    info "would remove $dest"
    return 0
  fi

  if cur=$(read_state 2>/dev/null) && [ "$cur" = "$slug" ]; then
    err "warning: $slug is the current theme; not switching"
  fi

  rm -f "$dest"
  stm_ledger_drop "$slug"
  info "removed $slug"
}

# ---------------------------------------------------------------------------
# adopt — snapshot + import + scrape + wire + apply
# ---------------------------------------------------------------------------

# Trusted wrapper written once by `stm adopt`. Never derived from palette
# content. stm will not rewrite this file again after the one-time wrap.
STM_ADOPT_WRAPPER='-- Generated once by stm adopt. Your original module is colors_user.lua.
-- stm will not rewrite this file again. Edit colors_user.lua for defaults.

local defaults = require("colors_user")
if type(defaults) ~= "table" then
  return defaults
end

local ok, generated = pcall(require, "colors_generated")
if ok and type(generated) == "table" then
  for k, v in pairs(generated) do
    defaults[k] = v
  end
end

return defaults'

# Conservative scrape of bar chrome and item slots. Data only: never eval,
# never source. Emits `layout<TAB>key<TAB>value` and `item<TAB>name<TAB>slot`.
# First declaration wins. color / border_color and unknown keys are skipped.
# macOS awk: no gensub, no {n} intervals.
# shellcheck disable=SC2016  # awk source
STM_SCRAPE_AWK='
function valid_layout(k, v,   n) {
  if (k == "color" || k == "border_color") return 0
  if (k == "position") return (v == "top" || v == "bottom")
  if (k == "sticky" || k == "topmost" || k == "shadow" || k == "hidden" || k == "font_smoothing")
    return (v == "on" || v == "off")
  if (k == "display") {
    if (v == "main" || v == "all") return 1
    if (v ~ /^[1-9]$/ || v ~ /^[1-9][0-9]$/) {
      n = v + 0
      return (n >= 1 && n <= 99)
    }
    return 0
  }
  if (k == "height") {
    if (v !~ /^[0-9]+$/) return 0
    n = v + 0
    return (n >= 1 && n <= 256)
  }
  if (k == "y_offset") {
    if (v !~ /^-?[0-9]+$/) return 0
    n = v + 0
    return (n >= -256 && n <= 256)
  }
  if (k == "notch_display_height" || k == "margin" || k == "corner_radius" ||
      k == "border_width" || k == "blur_radius" || k == "padding_left" ||
      k == "padding_right" || k == "notch_width" || k == "notch_offset") {
    if (v !~ /^[0-9]+$/) return 0
    n = v + 0
    return (n >= 0 && n <= 256)
  }
  return 0
}
function unquote(v) {
  gsub(/^["\047]|["\047]$/, "", v)
  return v
}
function emit_layout(k, v) {
  if (k in seen_l) return
  if (!valid_layout(k, v)) return
  seen_l[k] = 1
  printf("layout\t%s\t%s\n", k, v)
}
function emit_item(n, s) {
  if (n in seen_i) return
  if (n !~ /^[a-z][a-z0-9_.]*$/) return
  if (length(n) > 32) return
  if (s != "left" && s != "right" && s != "center") return
  seen_i[n] = 1
  printf("item\t%s\t%s\n", n, s)
}
{
  line = $0
  sub(/\r$/, "", line)

  if (line ~ /--bar([ \t]|$)/ || in_bar) {
    in_bar = 1
    n = split(line, parts, /[ \t]+/)
    for (i = 1; i <= n; i++) {
      if (parts[i] ~ /^[a-z_][a-z0-9_]*=/) {
        k = parts[i]; sub(/=.*$/, "", k)
        v = parts[i]; sub(/^[^=]*=/, "", v)
        v = unquote(v)
        if (v ~ /[$`();]/) continue
        emit_layout(k, v)
      }
    }
    if (line ~ /\\[ \t]*$/) in_bar = 1
    else in_bar = 0
  }

  if (line ~ /--add[ \t]+item[ \t]+/) {
    rest = line
    sub(/.*--add[ \t]+item[ \t]+/, "", rest)
    n = split(rest, parts, /[ \t]+/)
    if (n >= 2) emit_item(parts[1], parts[2])
  }

  if (line ~ /sbar\.bar[ \t]*[\({]/ || line ~ /[^A-Za-z0-9_]bar:set[ \t]*\(/ || line ~ /^[ \t]*bar:set[ \t]*\(/) {
    in_lua_bar = 1
    lua_bar_left = 20
  }

  if (in_lua_bar) {
    work = line
    sub(/--.*$/, "", work)
    while (match(work, /[a-z_][a-z0-9_]*[ \t]*=[ \t]*/)) {
      k = substr(work, RSTART, RLENGTH)
      sub(/[ \t]*=[ \t]*$/, "", k)
      work = substr(work, RSTART + RLENGTH)
      if (match(work, /^"[^"]*"/) || match(work, /^\047[^\047]*\047/) || match(work, /^-?[0-9]+/)) {
        v = substr(work, RSTART, RLENGTH)
        v = unquote(v)
        emit_layout(k, v)
        work = substr(work, RSTART + RLENGTH)
      } else {
        break
      }
    }
    lua_bar_left--
    if (line ~ /\}/ || lua_bar_left <= 0) in_lua_bar = 0
  }

  work = line
  sub(/--.*$/, "", work)
  if (match(work, /sbar\.add[ \t]*\(/)) {
    rest = substr(work, RSTART + RLENGTH)
    if (match(rest, /^[ \t]*"[^"]*"/) || match(rest, /^[ \t]*\047[^\047]*\047/)) {
      typ = rest
      typ = substr(typ, RSTART, RLENGTH)
      gsub(/^[ \t]+/, "", typ)
      typ = unquote(typ)
      if (typ == "item") {
        rest = substr(rest, RSTART + RLENGTH)
        sub(/^[ \t]*,[ \t]*/, "", rest)
        if (match(rest, /^"[^"]*"/) || match(rest, /^\047[^\047]*\047/)) {
          name = unquote(substr(rest, RSTART, RLENGTH))
          rest = substr(rest, RSTART + RLENGTH)
          if (match(rest, /position[ \t]*=[ \t]*/)) {
            rest = substr(rest, RSTART + RLENGTH)
            if (match(rest, /^"[^"]*"/) || match(rest, /^\047[^\047]*\047/)) {
              emit_item(name, unquote(substr(rest, RSTART, RLENGTH)))
            }
          }
        }
      }
    }
  }
}
'

# scrape_layout <dir> <out_file> — scan *.lua, *.sh, sketchybarrc. Does not
# follow .git/ or .stm-backups/. Does not eval or source.
scrape_layout() {
  local dir="$1" out="$2" raw rel f
  raw="${out}.raw"
  : >"$raw"
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    f="$dir/${rel#./}"
    [ -f "$f" ] || continue
    awk "$STM_SCRAPE_AWK" "$f"
  done >>"$raw" <<EOF
$(
    cd "$dir" 2>/dev/null || exit 0
    find . \( -path './.git' -o -path './.git/*' \
      -o -path './.stm-backups' -o -path './.stm-backups/*' \) -prune -o \
      \( -name '*.lua' -o -name '*.sh' -o -name 'sketchybarrc' \) \
      \( -type f -o -type l \) -print
  )
EOF
  # First declaration wins across files as well as inside a file.
  awk -F'\t' '
    $1 == "layout" || $1 == "item" {
      k = $1 SUBSEP $2
      if (k in seen) next
      seen[k] = 1
      print
    }
  ' "$raw" >"$out"
  rm -f "$raw"
}

append_palette_sections() {
  local dest="$1" scrape="$2"
  if grep -q '^layout	' "$scrape" 2>/dev/null; then
    printf '\n[layout]\n' >>"$dest"
    awk -F'\t' '$1=="layout" { printf("%s = \"%s\"\n", $2, $3) }' "$scrape" >>"$dest"
  fi
  if grep -q '^item	' "$scrape" 2>/dev/null; then
    printf '\n[items]\n' >>"$dest"
    awk -F'\t' '$1=="item" { printf("%s = \"%s\"\n", $2, $3) }' "$scrape" >>"$dest"
  fi
}

lua_file_is_wired() {
  local f="$1"
  [ -f "$f" ] || return 1
  grep -qE 'pcall[[:space:]]*\([[:space:]]*require[[:space:]]*,[[:space:]]*"colors_generated"[[:space:]]*\)|require[[:space:]]*\([[:space:]]*"colors_generated"[[:space:]]*\)' "$f"
}

print_adopt_wrapper() {
  printf '%s\n' "$STM_ADOPT_WRAPPER"
}

print_pos_snippet() {
  cat <<'EOF'

Optional: if a palette carries [layout] / [items], stm also writes
layout_generated.lua (or layout.sh). Item scripts are not edited. Wire
positions yourself when you want them themeable:

    local layout = {}
    local ok_l, generated_l = pcall(require, "layout_generated")
    if ok_l and type(generated_l) == "table" then
      layout = generated_l
    end

    local function pos(name, default)
      if layout.position_of and layout.position_of[name] then
        return layout.position_of[name]
      end
      return default
    end
EOF
}

# wire_lua_colors — one-time rename colors.lua -> colors_user.lua and write
# the trusted overlay wrapper. Sets ADOPT_WIRE to wired | already-wired | skipped.
wire_lua_colors() {
  local link="$RESOLVED_DIR/colors.lua" real user dir tmp

  ADOPT_WIRE="skipped"
  ADOPT_WIRE_REASON=""

  if [ "$OPT_NO_WIRE" -eq 1 ]; then
    ADOPT_WIRE_REASON="--no-wire"
    return 0
  fi
  if [ "$RESOLVED_FORMAT" = "bash" ]; then
    ADOPT_WIRE_REASON="bash: colors.sh is the apply target"
    return 0
  fi
  if [ "$RESOLVED_FORMAT" = "config-sh" ]; then
    ADOPT_WIRE_REASON="config-sh: not rewriting config.sh"
    return 0
  fi

  if [ ! -e "$link" ] && [ ! -L "$link" ]; then
    ADOPT_WIRE_REASON="no colors.lua"
    return 0
  fi

  if [ -L "$link" ]; then
    real=$(resolve_symlinks "$link")
  else
    real="$link"
  fi

  if [ ! -f "$real" ]; then
    ADOPT_WIRE_REASON="colors.lua is not a regular file"
    return 0
  fi
  if [ ! -r "$real" ]; then
    ADOPT_WIRE_REASON="colors.lua is unreadable"
    return 0
  fi

  if lua_file_is_wired "$real"; then
    ADOPT_WIRE="already-wired"
    return 0
  fi

  dir=$(dirname "$real")
  user="$dir/colors_user.lua"
  if [ -e "$user" ] && [ "$OPT_FORCE" -eq 0 ]; then
    ADOPT_WIRE_REASON="colors_user.lua already exists (pass --force to replace)"
    return 0
  fi

  if [ "$OPT_DRY_RUN" -eq 1 ]; then
    ADOPT_WIRE="wired"
    return 0
  fi

  mktemp_in "$dir"
  tmp="$STM_TMP"
  print_adopt_wrapper >"$tmp"

  # Rename first so a failed write cannot leave a half-wrapper over the original.
  if ! mv -f "$real" "$user"; then
    ADOPT_WIRE_REASON="could not rename colors.lua to colors_user.lua"
    return 0
  fi
  if ! commit_tmp "$tmp" "$real"; then
    # Best-effort undo of the rename if the wrapper could not be committed.
    mv -f "$user" "$real" 2>/dev/null || true
    ADOPT_WIRE_REASON="could not write wrapper"
    return 0
  fi

  ADOPT_WIRE="wired"
}

find_adopt_colours_src() {
  case "$RESOLVED_FORMAT" in
    lua)
      if [ -f "$RESOLVED_DIR/colors.lua" ]; then
        printf '%s\n' "$RESOLVED_DIR/colors.lua"
        return 0
      fi
      ;;
    bash | config-sh)
      if [ -f "$RESOLVED_DIR/colors.sh" ]; then
        printf '%s\n' "$RESOLVED_DIR/colors.sh"
        return 0
      fi
      ;;
  esac
  return 1
}

adopt_default_base() {
  local t
  if [ -n "$RESOLVED_CONFIG" ] && t=$(stm_config_get "$RESOLVED_CONFIG" default_theme 2>/dev/null); then
    if [ -n "$t" ] && [ "$t" != "auto" ]; then
      printf '%s\n' "$t"
      return 0
    fi
  fi
  printf 'tokyo-night\n'
}

cmd_adopt() {
  local slug="${1:-mine}"
  local snap_name="" dest dest_snap src n missing base="" pal_dir
  local blk scrape_file n_layout=0 n_items=0 layout_keys=""
  local did_import=0 did_apply=0 cfg saved_nobackup
  local src_fmt

  validate_slug "$slug"

  [ -d "$RESOLVED_DIR" ] || die "$EX_CONFIG" "sketchybar config dir does not exist: $RESOLVED_DIR"
  resolve_format
  [ "$RESOLVED_FORMAT" = "lua" ] && resolve_lua_dialect

  pal_dir=$(user_palette_dir) ||
    die "$EX_CONFIG" "could not determine a writable palette directory; pass --palette-dir"
  dest="$pal_dir/$slug.toml"

  if [ "$OPT_DRY_RUN" -eq 1 ]; then
    info "would adopt $slug"
    info "  dir:     $RESOLVED_DIR"
    info "  format:  $RESOLVED_FORMAT"
    if [ "$OPT_NO_BACKUP" -eq 1 ]; then
      info "  snapshot: skipped (--no-backup)"
    else
      if [ "$OPT_FORCE" -eq 1 ]; then
        snap_name="pre-adopt"
      else
        snap_name=$(fresh_backup_name "pre-adopt")
      fi
      info "  snapshot: --all -> .stm-backups/$snap_name"
    fi
    if src=$(find_adopt_colours_src); then
      info "  import:  $src -> $dest"
    else
      info "  import:  skipped (no colours file)"
    fi
    if [ "$OPT_NO_LAYOUT" -eq 1 ]; then
      info "  layout:  skipped (--no-layout)"
    else
      info "  layout:  scrape $RESOLVED_DIR (data only; item files untouched)"
    fi
    if [ "$OPT_NO_WIRE" -eq 1 ]; then
      info "  wire:    skipped (--no-wire)"
    elif [ "$RESOLVED_FORMAT" = "lua" ]; then
      info "  wire:    wrap colors.lua -> colors_user.lua + overlay wrapper"
    else
      info "  wire:    skipped ($RESOLVED_FORMAT)"
    fi
    if [ -e "$RESOLVED_DIR/stm.config.toml" ]; then
      info "  config:  keep existing stm.config.toml"
    else
      info "  config:  write $RESOLVED_DIR/stm.config.toml"
    fi
    info "  apply:   $slug --no-backup"
    return 0
  fi

  # 2. Snapshot first so any later hard failure is undoable.
  if [ "$OPT_NO_BACKUP" -eq 1 ]; then
    info "snapshot skipped (--no-backup; undo will not be available)"
  else
    if [ "$OPT_FORCE" -eq 1 ]; then
      snap_name="pre-adopt"
      dest_snap="$(backups_dir)/${snap_name:?}"
      if [ -e "$dest_snap" ]; then
        rm -rf "$dest_snap"
      fi
    else
      snap_name=$(fresh_backup_name "pre-adopt")
    fi
    n=$(snapshot_all "$snap_name")
    info "Backed up $n file(s) (all) -> $(backups_dir)/$snap_name"
  fi

  blk=$(mktemp -d "${TMPDIR:-/tmp}/.stm-blk.XXXXXX") ||
    die "$EX_CONFIG" "could not create a temporary directory"
  STM_TMPDIRS="$STM_TMPDIRS
$blk"

  # 3. Import colours. Missing canonical keys get an automatic base; that is
  # not a reason to abort the rest of adopt.
  if src=$(find_adopt_colours_src); then
    case "$src" in
      *.lua) src_fmt=lua ;;
      *) src_fmt=bash ;;
    esac
    if [ ! -r "$src" ]; then
      info "import skipped: $src is unreadable"
    else
      import_read_pairs "$src" "$src_fmt" "$blk/uniq" "$blk/skips"
      n=$(wc -l <"$blk/uniq" | tr -d ' ')
      if [ "$n" -eq 0 ]; then
        info "import skipped: found no colour definitions in $src"
      else
        if [ -e "$dest" ] && [ "$OPT_FORCE" -eq 0 ]; then
          die "$EX_EXISTS" "$dest already exists (use --force to overwrite)"
        fi
        mkdir -p "$pal_dir"
        missing=$(import_missing_required "$blk/uniq")
        base="$OPT_BASE"
        if [ -n "$missing" ] && [ -z "$OPT_BASE" ]; then
          base=$(adopt_default_base)
          info "missing required key(s):$missing"
          info "inheriting base = \"$base\" (pass --base to choose a different parent)"
        fi
        write_imported_palette "$dest" "$src" "$slug" "$base" "$blk/uniq"
        did_import=1
        info "imported $n colours from $src -> $dest"
        if [ -s "$blk/skips" ]; then
          info ""
          info "Could not import these (not an 0xAARRGGBB value):"
          awk -F'\t' '{ printf("  %-24s %s\n", $2, $3) }' "$blk/skips"
        fi
      fi
    fi
  else
    info "import skipped: no colours file found in $RESOLVED_DIR"
  fi

  # 4. Conservative layout scrape into the same palette.
  scrape_file="$blk/scrape"
  : >"$scrape_file"
  if [ "$OPT_NO_LAYOUT" -eq 1 ]; then
    info "layout scrape skipped (--no-layout)"
  else
    scrape_layout "$RESOLVED_DIR" "$scrape_file"
    n_layout=$(awk -F'\t' '$1=="layout" { n++ } END { print n+0 }' "$scrape_file")
    n_items=$(awk -F'\t' '$1=="item" { n++ } END { print n+0 }' "$scrape_file")
    layout_keys=$(awk -F'\t' '$1=="layout" { printf("%s ", $2) }' "$scrape_file")
    if [ "$did_import" -eq 1 ] && [ -f "$dest" ] && { [ "$n_layout" -gt 0 ] || [ "$n_items" -gt 0 ]; }; then
      cp "$dest" "$blk/palette-noscrape.toml"
      append_palette_sections "$dest" "$scrape_file"
      if ! stm_parse_palette "$dest" >/dev/null 2>&1; then
        mv -f "$blk/palette-noscrape.toml" "$dest"
        info "layout scrape dropped (palette would not validate); colours kept"
        n_layout=0
        n_items=0
        layout_keys=""
        : >"$scrape_file"
      fi
    fi
    if [ "$n_layout" -eq 0 ] && [ "$n_items" -eq 0 ]; then
      info "layout: none scraped"
    else
      info "layout: ${layout_keys:-}($n_layout keys), $n_items item(s)"
    fi
  fi

  # 5. Wire Lua so a later apply is visible.
  ADOPT_WIRE="skipped"
  ADOPT_WIRE_REASON=""
  wire_lua_colors
  case "$ADOPT_WIRE" in
    wired) info "wire: wrapped colors.lua -> colors_user.lua" ;;
    already-wired) info "wire: already wired (left colors.lua alone)" ;;
    *)
      info "wire: skipped${ADOPT_WIRE_REASON:+ ($ADOPT_WIRE_REASON)}"
      if [ "$RESOLVED_FORMAT" = "lua" ] && [ "$OPT_NO_WIRE" -eq 0 ]; then
        info ""
        info "Paste this as colors.lua if you want to wire by hand:"
        info ""
        print_adopt_wrapper
      fi
      ;;
  esac

  # 6. Config file — never clobber.
  cfg="$RESOLVED_DIR/stm.config.toml"
  if [ -e "$cfg" ]; then
    info "config: kept existing $cfg"
  else
    {
      printf '# written by stm adopt\n'
      printf 'sketchybar_dir = "%s"\n' "$RESOLVED_DIR"
      printf 'format = "%s"\n' "$RESOLVED_FORMAT"
      printf 'palette_dir = "%s"\n' "$pal_dir"
      printf 'default_theme = "%s"\n' "$slug"
    } >"$cfg"
    info "wrote $cfg"
  fi

  # 7. Apply with --no-backup; the --all snapshot is the undo.
  if [ "$did_import" -eq 1 ] && [ -f "$dest" ]; then
    saved_nobackup="$OPT_NO_BACKUP"
    OPT_NO_BACKUP=1
    cmd_apply "$slug"
    OPT_NO_BACKUP="$saved_nobackup"
    did_apply=1
  else
    info "apply skipped (no adopted palette to apply)"
  fi

  # 8. Report
  info ""
  info "Adopted $slug"
  info "  snapshot:  ${snap_name:-skipped}"
  info "  palette:   ${dest}"
  info "  wire:      ${ADOPT_WIRE}${ADOPT_WIRE_REASON:+ ($ADOPT_WIRE_REASON)}"
  if [ "$OPT_NO_LAYOUT" -eq 1 ]; then
    info "  layout:    skipped"
  elif [ "$n_layout" -eq 0 ] && [ "$n_items" -eq 0 ]; then
    info "  layout:    none scraped"
  else
    info "  layout:    ${layout_keys:-}($n_layout keys), $n_items item(s)"
  fi
  if [ -n "$snap_name" ]; then
    info "  restore:   stm restore $snap_name"
  fi
  if [ "$did_apply" -eq 1 ] && [ "$RESOLVED_FORMAT" = "lua" ]; then
    if [ "$n_items" -gt 0 ] || [ "$n_layout" -gt 0 ]; then
      print_pos_snippet
    fi
  fi
  info ""
  cmd_doctor "$slug" || true
}

usage() {
  cat <<EOF
$PROGNAME $STM_VERSION — SketchyBar Theme Manager

USAGE
  $PROGNAME <command> [args] [options]

COMMANDS
  list                          List available themes
  apply <theme>                 Apply a theme, then run \`sketchybar --reload\`
  current                       Print the active theme slug
  init [--format lua|bash]      Scaffold ./palettes and ./stm.config.toml
  add <theme> <palette-file>    Install a local palette file into your palette directory
  preview <theme>               Print a theme's colour table (writes nothing)
  lint [<file>|<slug>]          Validate a palette (writes nothing)
  install <spec>                Fetch one HTTPS .toml, lint, and store it (no apply)
  uninstall <slug>              Remove a user-installed palette
  remove <slug>                 Alias for uninstall
  doctor [theme]                Diagnose the config: format, dialect, key coverage
  verify                        Check that stm touched only the files it owns
  import [<file>]               Turn an existing colours file into a palette
  export <theme>                Print a theme as canonical palette TOML
  adopt [slug]                  Make an existing bar stm-compatible (default slug: mine)
  backup [name]                 Snapshot stm-owned files (or --all for the whole dir)
  restore [name]                Restore a snapshot (latest auto if name omitted)
  backups                       List snapshots
  help                          Show this help
  version                       Print the version

OPTIONS
  --dir <path>          SketchyBar config dir (overrides \$SKETCHYBAR_CONFIG_DIR)
  --palette-dir <path>  Palette directory to search
  --config <path>       Path to stm.config.toml
  --format lua|bash     Force the output format instead of auto-detecting
  --lua-dialect <d>     flat | nested | auto (default: auto-detect)
  --no-reload           Do not run \`sketchybar --reload\` after applying
  --no-manifest         Do not record a checksum baseline on apply
  --backup-each         Keep a timestamped backup before each destructive write
  --no-backup           Do not take an auto snapshot on apply (or adopt)
  --no-wire             (adopt) Skip the Lua colors.lua wrap
  --no-layout           (adopt) Skip the conservative layout scrape
  --reset-layout        Delete the generated layout overlay on apply
  --all                 (backup) Snapshot the whole config dir, not just stm files
  --dry-run             Show what would change; write nothing
  --force               Allow add/import/adopt/install to overwrite
  --allow-host <host>   Permit one extra HTTPS host for \`install\`
  --append-missing      (bash) Append palette keys absent from colors.sh
  --porcelain           Machine-readable output for \`list\`, \`preview\` and \`lint\`
  --out <file>          Write \`export\` output to a file instead of stdout
  --slug <slug>         Name for the palette \`import\` creates
  --base <slug>         Make the imported palette inherit from <slug>
  -v, --verbose         Extra detail on stderr
  -q, --quiet           Suppress non-error output
  -h, --help            Show this help
  -V, --version         Print the version

ENVIRONMENT
  SKETCHYBAR_CONFIG_DIR   SketchyBar config directory
  STM_CONFIG              Path to stm.config.toml
  STM_PALETTE_DIR         Additional palette directory
  STM_FORMAT              lua | bash
  STM_LUA_DIALECT         flat | nested
  STM_FETCH               Test-only fetch stub (\`STM_FETCH <url> <dest>\`)
  NO_COLOR                Disable colour swatches in \`preview\`

EXIT CODES
  0 success   1 invalid palette   2 config/format error
  3 theme not found   4 refusing to overwrite   5 network/fetch
  64 usage error

EOF
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

main() {
  local cmd="" args_left=""
  local -a positional
  positional=()

  if [ "$#" -eq 0 ]; then
    usage >&2
    exit "$EX_USAGE"
  fi

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dir)
        [ "$#" -ge 2 ] || die "$EX_USAGE" "--dir needs a value"
        OPT_DIR="$2"
        shift 2
        ;;
      --dir=*) OPT_DIR="${1#--dir=}"; shift ;;
      --palette-dir)
        [ "$#" -ge 2 ] || die "$EX_USAGE" "--palette-dir needs a value"
        OPT_PALETTE_DIR="$2"
        shift 2
        ;;
      --palette-dir=*) OPT_PALETTE_DIR="${1#--palette-dir=}"; shift ;;
      --config)
        [ "$#" -ge 2 ] || die "$EX_USAGE" "--config needs a value"
        OPT_CONFIG="$2"
        shift 2
        ;;
      --config=*) OPT_CONFIG="${1#--config=}"; shift ;;
      --format)
        [ "$#" -ge 2 ] || die "$EX_USAGE" "--format needs a value"
        OPT_FORMAT="$2"
        shift 2
        ;;
      --format=*) OPT_FORMAT="${1#--format=}"; shift ;;
      --lua-dialect)
        [ "$#" -ge 2 ] || die "$EX_USAGE" "--lua-dialect needs a value"
        OPT_LUA_DIALECT="$2"
        shift 2
        ;;
      --lua-dialect=*) OPT_LUA_DIALECT="${1#--lua-dialect=}"; shift ;;
      --out)
        [ "$#" -ge 2 ] || die "$EX_USAGE" "--out needs a value"
        OPT_OUT="$2"
        shift 2
        ;;
      --out=*) OPT_OUT="${1#--out=}"; shift ;;
      --slug)
        [ "$#" -ge 2 ] || die "$EX_USAGE" "--slug needs a value"
        OPT_SLUG="$2"
        shift 2
        ;;
      --slug=*) OPT_SLUG="${1#--slug=}"; shift ;;
      --base)
        [ "$#" -ge 2 ] || die "$EX_USAGE" "--base needs a value"
        OPT_BASE="$2"
        shift 2
        ;;
      --base=*) OPT_BASE="${1#--base=}"; shift ;;
      --no-reload) OPT_NO_RELOAD=1; shift ;;
      --no-manifest) OPT_NO_MANIFEST=1; shift ;;
      --backup-each) OPT_BACKUP_EACH=1; shift ;;
      --no-backup) OPT_NO_BACKUP=1; shift ;;
      --no-wire) OPT_NO_WIRE=1; shift ;;
      --no-layout) OPT_NO_LAYOUT=1; shift ;;
      --reset-layout) OPT_RESET_LAYOUT=1; shift ;;
      --all) OPT_ALL=1; shift ;;
      --dry-run) OPT_DRY_RUN=1; shift ;;
      --force) OPT_FORCE=1; shift ;;
      --allow-host)
        [ "$#" -ge 2 ] || die "$EX_USAGE" "--allow-host needs a value"
        OPT_ALLOW_HOST="$2"
        shift 2
        ;;
      --allow-host=*) OPT_ALLOW_HOST="${1#--allow-host=}"; shift ;;
      --append-missing) OPT_APPEND_MISSING=1; shift ;;
      --porcelain) OPT_PORCELAIN=1; shift ;;
      -v | --verbose) OPT_VERBOSE=1; shift ;;
      -q | --quiet) OPT_QUIET=1; shift ;;
      -h | --help)
        usage
        exit "$EX_OK"
        ;;
      -V | --version)
        printf '%s %s\n' "$PROGNAME" "$STM_VERSION"
        exit "$EX_OK"
        ;;
      --)
        shift
        while [ "$#" -gt 0 ]; do
          positional+=("$1")
          shift
        done
        ;;
      -*) die "$EX_USAGE" "unknown option: $1" ;;
      *)
        positional+=("$1")
        shift
        ;;
    esac
  done

  if [ "${#positional[@]}" -eq 0 ]; then
    usage >&2
    exit "$EX_USAGE"
  fi

  if [ -n "$OPT_FORMAT" ]; then
    case "$OPT_FORMAT" in
      lua | bash | config-sh) : ;;
      *) die "$EX_USAGE" "--format must be lua, bash or config-sh (got \"$OPT_FORMAT\")" ;;
    esac
  fi

  if [ -n "$OPT_LUA_DIALECT" ]; then
    case "$OPT_LUA_DIALECT" in
      flat | nested | auto) : ;;
      *) die "$EX_USAGE" "--lua-dialect must be flat, nested or auto (got \"$OPT_LUA_DIALECT\")" ;;
    esac
    [ "$OPT_LUA_DIALECT" = "auto" ] && OPT_LUA_DIALECT=""
  fi

  cmd="${positional[0]}"
  args_left=$((${#positional[@]} - 1))

  resolve_config_file
  resolve_sketchybar_dir

  case "$cmd" in
    list)
      cmd_list
      ;;
    apply)
      [ "$args_left" -ge 1 ] || die "$EX_USAGE" "apply needs a theme name"
      cmd_apply "${positional[1]}"
      ;;
    current)
      cmd_current
      ;;
    preview)
      [ "$args_left" -ge 1 ] || die "$EX_USAGE" "preview needs a theme name"
      cmd_preview "${positional[1]}"
      ;;
    lint)
      [ "$args_left" -ge 1 ] || die "$EX_USAGE" "lint needs a palette file or theme name"
      cmd_lint "${positional[1]}"
      ;;
    install)
      [ "$args_left" -ge 1 ] || die "$EX_USAGE" "install needs owner/repo/path.toml"
      cmd_install "${positional[1]}"
      ;;
    uninstall | remove)
      [ "$args_left" -ge 1 ] || die "$EX_USAGE" "uninstall needs a theme name"
      cmd_uninstall "${positional[1]}"
      ;;
    init)
      cmd_init
      ;;
    add)
      [ "$args_left" -ge 2 ] || die "$EX_USAGE" "add needs a theme name and a palette file"
      cmd_add "${positional[1]}" "${positional[2]}"
      ;;
    export)
      [ "$args_left" -ge 1 ] || die "$EX_USAGE" "export needs a theme name"
      cmd_export "${positional[1]}"
      ;;
    import)
      if [ "$args_left" -ge 1 ]; then
        cmd_import "${positional[1]}"
      else
        cmd_import
      fi
      ;;
    adopt)
      if [ "$args_left" -ge 1 ]; then
        cmd_adopt "${positional[1]}"
      else
        cmd_adopt
      fi
      ;;
    verify)
      cmd_verify
      ;;
    backup)
      if [ "$args_left" -ge 1 ]; then
        cmd_backup "${positional[1]}"
      else
        cmd_backup
      fi
      ;;
    restore)
      if [ "$args_left" -ge 1 ]; then
        cmd_restore "${positional[1]}"
      else
        cmd_restore
      fi
      ;;
    backups)
      cmd_backups
      ;;
    doctor)
      if [ "$args_left" -ge 1 ]; then
        cmd_doctor "${positional[1]}"
      else
        cmd_doctor
      fi
      ;;
    help)
      usage
      ;;
    version)
      printf '%s %s\n' "$PROGNAME" "$STM_VERSION"
      ;;
    *)
      err "unknown command: $cmd"
      usage >&2
      exit "$EX_USAGE"
      ;;
  esac
}

main "$@"
